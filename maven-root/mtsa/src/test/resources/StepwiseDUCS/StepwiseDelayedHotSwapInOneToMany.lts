// Full-pipeline regression fixture for a legitimate one-to-many hotSwapIn
// connection relation H.  OLD_ENV is a deterministic two-state cycle, while
// OldCon is its valid one-state quotient.  Synchronised reachability therefore
// relates the sole OldCon state to both OLD-side mapping states.  mapRelation
// itself remains total and one-to-one so that reconfigure is deterministic.

set ControllableActions = {tick}

OLD_ENV = OLD_A,
OLD_A = (tick -> OLD_B),
OLD_B = (tick -> OLD_A).

NEW_ENV = NEW_A,
NEW_A = (tick -> NEW_B),
NEW_B = (tick -> NEW_A).

relation R_ENV = {
    OLD_A@OLD_ENV = reconfigure -> NEW_A@NEW_ENV,
    OLD_B@OLD_ENV = reconfigure -> NEW_B@NEW_ENV
}

map MAP_ENV = {OLD_ENV, NEW_ENV, R_ENV}

||MAPPING_ENV = (MAP_ENV).

controllerSpec OLD_REQ = {
    safety = {}
    controllable = {ControllableActions}
}

// This quotient has exactly the same controlled trace language as OLD_ENV.
OLD_CLOSED_LOOP = (tick -> OLD_CLOSED_LOOP).
||OldCon = (OLD_CLOSED_LOOP).

controllerSpec NEW_REQ = {
    safety = {}
    controllable = {ControllableActions}
}

||NewCon = (NEW_ENV).

fluent SeenTick = <tick, stopOldSpec>
ltl_property T_KEEP_LAST_TICK = [](SeenTick -> tick)

// When raw H_T is one-to-many, both an explicitly selected legacy-stutter run
// of the unflagged target and the explicit Traditional-monitor target must
// connect all raw targets before evaluating this transition requirement.  The
// legacy target name is retained for regression continuity; it no longer
// denotes history-correlated preconnection monitor pruning.

updatingController Stepwise_OneToMany = {
    oldController = OldCon,
    oldEnvironment = {OLD_ENV},
    newEnvironment = {NEW_ENV},
    mapRelation = {R_ENV},
    oldGoal = OLD_REQ,
    newGoal = NEW_REQ,
    nonblocking,
    stepwise_delayed,
    safetyBackwardPruning
}

updatingController Stepwise_TraditionalMonitor_NoTransition_OneToMany = {
    oldController = OldCon,
    oldEnvironment = {OLD_ENV},
    newEnvironment = {NEW_ENV},
    mapRelation = {R_ENV},
    oldGoal = OLD_REQ,
    newGoal = NEW_REQ,
    nonblocking,
    stepwise_delayed,
    safetyBackwardPruning,
    traditionalHotSwapMonitorSemantics
}

updatingController Stepwise_LegacyMonitorBoundary_OneToMany = {
    oldController = OldCon,
    oldEnvironment = {OLD_ENV},
    newEnvironment = {NEW_ENV},
    mapRelation = {R_ENV},
    oldGoal = OLD_REQ,
    newGoal = NEW_REQ,
    transition = T_KEEP_LAST_TICK,
    nonblocking,
    stepwise_delayed,
    safetyBackwardPruning
}

updatingController Stepwise_TraditionalMonitorBoundary_OneToMany = {
    oldController = OldCon,
    oldEnvironment = {OLD_ENV},
    newEnvironment = {NEW_ENV},
    mapRelation = {R_ENV},
    oldGoal = OLD_REQ,
    newGoal = NEW_REQ,
    transition = T_KEEP_LAST_TICK,
    nonblocking,
    stepwise_delayed,
    safetyBackwardPruning,
    traditionalHotSwapMonitorSemantics
}

||STEPWISE_ONE_TO_MANY = Stepwise_OneToMany.
||STEPWISE_TRADITIONAL_MONITOR_NO_TRANSITION_ONE_TO_MANY =
        Stepwise_TraditionalMonitor_NoTransition_OneToMany.
||STEPWISE_LEGACY_MONITOR_BOUNDARY_ONE_TO_MANY =
        Stepwise_LegacyMonitorBoundary_OneToMany.
||STEPWISE_TRADITIONAL_MONITOR_BOUNDARY_ONE_TO_MANY =
        Stepwise_TraditionalMonitorBoundary_OneToMany.
