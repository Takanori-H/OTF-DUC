//******************************************************************************
//* ArtGallery2RoomsBase.lts
//*
//* Clean two-room static baseline for a future stepwise_delayed update model.
//* Shared action names and the shared UNLOCK_TIME fluent are intentionally kept.
//* No updatingController or update scenario is defined in this file.
//******************************************************************************

//******************************************************************************
//* Scale and thresholds
//******************************************************************************

const N = 4
const TH_HALL = 2
const TH_A = 2

//******************************************************************************
//* Action ownership
//******************************************************************************

set VisitorAction = {reqEnter_Hall,reqEnter_A,reqOut}

set HallLockAction = {lock_Hall,unLock_Hall}
set RoomALockAction = {lock_A,unLock_A}
set LockAction = {HallLockAction,RoomALockAction}

// All admission decisions are controllable.  The original two-room file
// omitted allow_Out, deny_Hall, and deny_A from its controllable set.
set DecisionAction = {
	allow_Hall,deny_Hall,
	allow_A,deny_A,
	allow_Out,deny_Out
}

// Kept controllable to preserve the semantics used by the original benchmark.
// A sensor-response interpretation should be evaluated as a separate variant.
set StatusAction = {resRoomStatus}

set DoorAction = {LockAction,DecisionAction,StatusAction}
set MonitorAction = {notEnter,arrive_Hall[1..N],arrive_A[1..N],leave}
set AllAction = {VisitorAction,DoorAction,MonitorAction}

set ControllableActions = {DoorAction}
set HallStageControllableActions = {
	HallLockAction,DecisionAction,StatusAction
}

//******************************************************************************
//* Environment
//******************************************************************************

VISITOR = VISIT,
VISIT =
(
	reqEnter_Hall -> resRoomStatus -> CHECK_HALL
	|reqEnter_A   -> resRoomStatus -> CHECK_A
	|reqOut       -> resRoomStatus -> CHECK_OUT
),
CHECK_HALL =
(
	allow_Hall -> arrive_Hall[1..N] -> VISIT
	|deny_Hall -> notEnter -> VISIT
),
CHECK_A =
(
	allow_A -> arrive_A[1..N] -> VISIT
	|deny_A -> arrive_Hall[1..N] -> VISIT
),
CHECK_OUT =
(
	allow_Out -> leave -> VISIT
	|deny_Out -> arrive_A[1..N] -> VISIT
).

HALL = HALL[0],
HALL[n:0..N] =
(
	when(n!=N) allow_Hall -> arrive_Hall[n+1] -> HALL[n+1]
	|when(n!=N) deny_A -> arrive_Hall[n+1] -> HALL[n+1]
	|when(n!=0) reqEnter_A -> HALL[n-1]
).

ROOM_A = ROOM_A[0],
ROOM_A[n:0..N] =
(
	when(n!=N) allow_A -> arrive_A[n+1] -> ROOM_A[n+1]
	|when(n!=N) deny_Out -> arrive_A[n+1] -> ROOM_A[n+1]
	|when(n!=0) reqOut -> ROOM_A[n-1]
).

DOOR_LOCK_HALL = LOCK_HALL,
LOCK_HALL = (lock_Hall -> unLock_Hall -> LOCK_HALL).

DOOR_LOCK_A = LOCK_A,
LOCK_A = (lock_A -> unLock_A -> LOCK_A).

||Environment =
(
	VISITOR || HALL || ROOM_A || DOOR_LOCK_HALL || DOOR_LOCK_A
).

//******************************************************************************
//* Fluents
//******************************************************************************

fluent HALL_LOCKED = <lock_Hall,unLock_Hall>
fluent HALL_TH_LOCKED1 = <arrive_Hall[TH_HALL],allow_A>
fluent HALL_TH_LOCKED2 = <lock_Hall,allow_A>
fluent HALL_LOCK_TIME = <arrive_Hall[TH_HALL],resRoomStatus>

// Pending obligations replace the nested X / W formulas.
// Both lock and unlock reset the pending bit.  Together with the LOCKED guard,
// this preserves the original conditional trigger when arrive_Hall[TH_HALL]
// or allow_A occurs while the Hall is already in the opposite lock state.
fluent HALL_LOCK_PENDING =
	<arrive_Hall[TH_HALL],{lock_Hall,unLock_Hall}>
fluent HALL_UNLOCK_PENDING =
	<allow_A,{unLock_Hall,lock_Hall}>

fluent A_LOCKED = <lock_A,unLock_A>
fluent A_TH_LOCKED1 = <arrive_A[TH_A],allow_Out>
fluent A_TH_LOCKED2 = <lock_A,allow_Out>
fluent A_LOCK_TIME = <arrive_A[TH_A],resRoomStatus>

fluent A_LOCK_PENDING =
	<arrive_A[TH_A],{lock_A,unLock_A}>
fluent A_UNLOCK_PENDING =
	<allow_Out,{unLock_A,lock_A}>

// Intentionally shared by Hall and Room A, as in the original model.
fluent UNLOCK_TIME = <MonitorAction,resRoomStatus>

//******************************************************************************
//* State-based safety requirements
//******************************************************************************

assert VISITOR_RULE_HALL = (HALL_LOCKED -> !allow_Hall)

// Equivalent obligation for:
// ((!HALL_LOCKED && arrive_Hall[TH_HALL])
//      -> X(!resRoomStatus W lock_Hall))
assert LOCK_RULE_HALL1 =
	(((!HALL_LOCKED) && HALL_LOCK_PENDING) -> !resRoomStatus)

assert LOCK_RULE_HALL2 =
	((HALL_TH_LOCKED1 && HALL_TH_LOCKED2) -> !unLock_Hall)

// Equivalent obligation for:
// ((HALL_LOCKED && allow_A)
//      -> X(!resRoomStatus W unLock_Hall))
assert UNLOCK_RULE_HALL1 =
	((HALL_LOCKED && HALL_UNLOCK_PENDING) -> !resRoomStatus)

assert HALL_LOCK_TIMING = (!HALL_LOCK_TIME -> !lock_Hall)
assert HALL_UNLOCK_TIMING = (!UNLOCK_TIME -> !unLock_Hall)

assert VISITOR_RULE_A = (A_LOCKED -> !allow_A)

// Equivalent obligation for:
// ((!A_LOCKED && arrive_A[TH_A])
//      -> X(!resRoomStatus W lock_A))
assert LOCK_RULE_A1 =
	(((!A_LOCKED) && A_LOCK_PENDING) -> !resRoomStatus)

assert LOCK_RULE_A2 =
	((A_TH_LOCKED1 && A_TH_LOCKED2) -> !unLock_A)

// Equivalent obligation for:
// ((A_LOCKED && allow_Out)
//      -> X(!resRoomStatus W unLock_A))
assert UNLOCK_RULE_A1 =
	((A_LOCKED && A_UNLOCK_PENDING) -> !resRoomStatus)

assert A_LOCK_TIMING = (!A_LOCK_TIME -> !lock_A)
assert A_UNLOCK_TIMING = (!UNLOCK_TIME -> !unLock_A)

ltl_property P_VISITOR_RULE_HALL = []VISITOR_RULE_HALL
ltl_property P_LOCK_RULE_HALL1 = []LOCK_RULE_HALL1
ltl_property P_LOCK_RULE_HALL2 = []LOCK_RULE_HALL2
ltl_property P_UNLOCK_RULE_HALL1 = []UNLOCK_RULE_HALL1
ltl_property P_HALL_LOCK_TIMING = []HALL_LOCK_TIMING
ltl_property P_HALL_UNLOCK_TIMING = []HALL_UNLOCK_TIMING

ltl_property P_VISITOR_RULE_A = []VISITOR_RULE_A
ltl_property P_LOCK_RULE_A1 = []LOCK_RULE_A1
ltl_property P_LOCK_RULE_A2 = []LOCK_RULE_A2
ltl_property P_UNLOCK_RULE_A1 = []UNLOCK_RULE_A1
ltl_property P_A_LOCK_TIMING = []A_LOCK_TIMING
ltl_property P_A_UNLOCK_TIMING = []A_UNLOCK_TIMING

//******************************************************************************
//* Controller goals
//******************************************************************************

controllerSpec Specification =
{
	safety = {
		P_VISITOR_RULE_HALL,
		P_LOCK_RULE_HALL1,
		P_LOCK_RULE_HALL2,
		P_UNLOCK_RULE_HALL1,
		P_HALL_LOCK_TIMING,
		P_HALL_UNLOCK_TIMING,
		P_VISITOR_RULE_A,
		P_LOCK_RULE_A1,
		P_LOCK_RULE_A2,
		P_UNLOCK_RULE_A1,
		P_A_LOCK_TIMING,
		P_A_UNLOCK_TIMING
	}
	controllable = {ControllableActions}
}

controllerSpec PartSpec1 =
{
	safety = {
		P_VISITOR_RULE_HALL,
		P_LOCK_RULE_HALL1,
		P_LOCK_RULE_HALL2,
		P_UNLOCK_RULE_HALL1,
		P_HALL_LOCK_TIMING,
		P_HALL_UNLOCK_TIMING
	}
	controllable = {HallStageControllableActions}
}

controllerSpec PartSpec2 =
{
	safety = {
		P_VISITOR_RULE_A,
		P_LOCK_RULE_A1,
		P_LOCK_RULE_A2,
		P_UNLOCK_RULE_A1,
		P_A_LOCK_TIMING,
		P_A_UNLOCK_TIMING
	}
	controllable = {ControllableActions}
}

//******************************************************************************
//* Static baseline targets
//******************************************************************************

controller ||TraditionalController = (Environment)~{Specification}.

||PartEnv1 = (VISITOR || HALL || ROOM_A || DOOR_LOCK_HALL).
controller ||C1 = (PartEnv1)~{PartSpec1}.
||PartEnv2 = (C1 || DOOR_LOCK_A).
controller ||C2 = (PartEnv2)~{PartSpec2}.
||StepwiseController = (C2).
