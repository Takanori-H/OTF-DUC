//******************************************************************************
//*  Drone DUC problem for MTSA
//*  Base model : Drone(N, 2 drone).lts
//*  Update     : N=2, X=2, Y=2, S=2 -> X=2, Y=3, S=2
//******************************************************************************

//*****************************************************************************
// Environment
//*****************************************************************************

const N = 2

const OldMaxX = 2
const OldMaxY = 2
const OldMaxH = 2

const NewMaxX = 2
const NewMaxY = 3
const NewMaxH = 2

const OldLimitX = OldMaxX
const OldLimitY = OldMaxY
const NewLimitX = NewMaxX
const NewLimitY = NewMaxY

range DroneID = 1..N
set Drones = {drone[DroneID]}

range OldX = 1..OldMaxX
range OldY = 1..OldMaxY
range OldH = 1..OldMaxH

range NewX = 1..NewMaxX
range NewY = 1..NewMaxY
range NewH = 1..NewMaxH

set Direction = {n,s,e,w}

set DroneActions = {drone[DroneID].takeoff, drone[DroneID].land, drone[DroneID].up, drone[DroneID].down, drone[DroneID].move[Direction]}
set BatterySafeActions = {drone[DroneID].battery['safe]}
set ControllableActions = {BatterySafeActions, DroneActions}

//*****************************************************************************
// Old and new domain models
//*****************************************************************************

BATTERY_OLD(I=1) = (drone[I].battery['low] -> LOW_OLD),
LOW_OLD = (drone[I].battery['safe] -> BATTERY_OLD).

BATTERY_NEW(I=1) = (drone[I].battery['low] -> LOW_NEW),
LOW_NEW = (drone[I].battery['safe] -> BATTERY_NEW).

MOVE_OLD(I=1) = (drone[I].takeoff -> drone[I].arrive[1][1][1] -> ACTION_OLD[1][1][1]),
ACTION_OLD[x:OldX][y:OldY][h:OldH] = (when(x > 1)       drone[I].move['w] -> drone[I].arrive[x-1][y][h] -> ACTION_OLD[x-1][y][h]
                                      |when(x < OldMaxX) drone[I].move['e] -> drone[I].arrive[x+1][y][h] -> ACTION_OLD[x+1][y][h]
                                      |when(y > 1)       drone[I].move['s] -> drone[I].arrive[x][y-1][h] -> ACTION_OLD[x][y-1][h]
                                      |when(y < OldMaxY) drone[I].move['n] -> drone[I].arrive[x][y+1][h] -> ACTION_OLD[x][y+1][h]
                                      |when(h > 1)       drone[I].down     -> drone[I].arrive[x][y][h-1] -> ACTION_OLD[x][y][h-1]
                                      |when(h < OldMaxH) drone[I].up       -> drone[I].arrive[x][y][h+1] -> ACTION_OLD[x][y][h+1]
                                      |when(h == 1)      drone[I].land     -> MOVE_OLD).

MOVE_NEW(I=1) = (drone[I].takeoff -> drone[I].arrive[1][1][1] -> ACTION_NEW[1][1][1]),
ACTION_NEW[x:NewX][y:NewY][h:NewH] = (when(x > 1)       drone[I].move['w] -> drone[I].arrive[x-1][y][h] -> ACTION_NEW[x-1][y][h]
                                      |when(x < NewMaxX) drone[I].move['e] -> drone[I].arrive[x+1][y][h] -> ACTION_NEW[x+1][y][h]
                                      |when(y > 1)       drone[I].move['s] -> drone[I].arrive[x][y-1][h] -> ACTION_NEW[x][y-1][h]
                                      |when(y < NewMaxY) drone[I].move['n] -> drone[I].arrive[x][y+1][h] -> ACTION_NEW[x][y+1][h]
                                      |when(h > 1)       drone[I].down     -> drone[I].arrive[x][y][h-1] -> ACTION_NEW[x][y][h-1]
                                      |when(h < NewMaxH) drone[I].up       -> drone[I].arrive[x][y][h+1] -> ACTION_NEW[x][y][h+1]
                                      |when(h == 1)      drone[I].land     -> MOVE_NEW).

||OLD_BATTERY_ENV = (forall[i:DroneID] BATTERY_OLD(i)).
||OLD_MOVE_ENV = (forall[i:DroneID] MOVE_OLD(i)).
||OLD_ENV = (OLD_BATTERY_ENV || OLD_MOVE_ENV).

||NEW_BATTERY_ENV = (forall[i:DroneID] BATTERY_NEW(i)).
||NEW_MOVE_ENV = (forall[i:DroneID] MOVE_NEW(i)).
||NEW_ENV = (NEW_BATTERY_ENV || NEW_MOVE_ENV).

//*****************************************************************************
// Mapping relation
//*****************************************************************************

relation R_BATTERY(I) = {BATTERY_OLD@BATTERY_OLD(I) = reconfigure -> BATTERY_NEW@BATTERY_NEW(I),
                         LOW_OLD@BATTERY_OLD(I) = reconfigure -> LOW_NEW@BATTERY_NEW(I)}

relation R_MOVE(I) = {MOVE_OLD@MOVE_OLD(I) = reconfigure -> MOVE_NEW@MOVE_NEW(I),
                      forall[x:OldX][y:OldY][h:OldH] ACTION_OLD[x][y][h]@MOVE_OLD(I) = reconfigure -> ACTION_NEW[x][y][h]@MOVE_NEW(I)}

map MAP_BATTERY_1 = {BATTERY_OLD(1), BATTERY_NEW(1), R_BATTERY(1)}
map MAP_MOVE_1 = {MOVE_OLD(1), MOVE_NEW(1), R_MOVE(1)}
map MAP_BATTERY_2 = {BATTERY_OLD(2), BATTERY_NEW(2), R_BATTERY(2)}
map MAP_MOVE_2 = {MOVE_OLD(2), MOVE_NEW(2), R_MOVE(2)}

||MAP_ENV = (MAP_BATTERY_1 || MAP_MOVE_1 || MAP_BATTERY_2 || MAP_MOVE_2).

//*****************************************************************************
// Safety properties
//*****************************************************************************

fluent LANDING[i:DroneID] = <drone[i].land, drone[i].takeoff> initially 1
fluent LOW_BATTERY[i:DroneID] = <drone[i].battery['low], drone[i].battery['safe]> initially 0

assert LOW_BATTERY_LAND_1 = (!LANDING[1] -> !drone[1].battery['safe])
assert LOW_BATTERY_UP_1 = (LOW_BATTERY[1] -> !drone[1].up)
assert LOW_BATTERY_MOVE_X_1 = (LOW_BATTERY[1] -> !drone[1].move['e])
assert LOW_BATTERY_MOVE_Y_1 = (LOW_BATTERY[1] -> !drone[1].move['n])

assert LOW_BATTERY_LAND_2 = (!LANDING[2] -> !drone[2].battery['safe])
assert LOW_BATTERY_UP_2 = (LOW_BATTERY[2] -> !drone[2].up)
assert LOW_BATTERY_MOVE_X_2 = (LOW_BATTERY[2] -> !drone[2].move['e])
assert LOW_BATTERY_MOVE_Y_2 = (LOW_BATTERY[2] -> !drone[2].move['n])

ltl_property P_LOW_BATTERY_LAND_1 = []LOW_BATTERY_LAND_1
ltl_property P_LOW_BATTERY_UP_1 = []LOW_BATTERY_UP_1
ltl_property P_LOW_BATTERY_MOVE_X_1 = []LOW_BATTERY_MOVE_X_1
ltl_property P_LOW_BATTERY_MOVE_Y_1 = []LOW_BATTERY_MOVE_Y_1

ltl_property P_LOW_BATTERY_LAND_2 = []LOW_BATTERY_LAND_2
ltl_property P_LOW_BATTERY_UP_2 = []LOW_BATTERY_UP_2
ltl_property P_LOW_BATTERY_MOVE_X_2 = []LOW_BATTERY_MOVE_X_2
ltl_property P_LOW_BATTERY_MOVE_Y_2 = []LOW_BATTERY_MOVE_Y_2

// Old range boundary: X=2, Y=2 are forbidden boundary cells.
assert OLD_MOVE_LIMIT_1 = (!drone[1].arrive[OldLimitX][OldY][OldH])
assert OLD_MOVE_LIMIT_2 = (!drone[2].arrive[OldX][OldLimitY][OldH])
ltl_property P_OLD_MOVE_LIMIT_1 = []OLD_MOVE_LIMIT_1
ltl_property P_OLD_MOVE_LIMIT_2 = []OLD_MOVE_LIMIT_2

assert OLD_NO_COLLISION_11 = (drone[1].arrive[OldX][OldY][1] -> X(![Drones].arrive[OldX][OldY][1] W {drone[1].arrive[OldX][OldY][OldH], drone[1].land}))
ltl_property P_OLD_NO_COLLISION_11 = []OLD_NO_COLLISION_11
assert OLD_NO_COLLISION_12 = (drone[1].arrive[OldX][OldY][2] -> X(![Drones].arrive[OldX][OldY][2] W {drone[1].arrive[OldX][OldY][OldH], drone[1].land}))
ltl_property P_OLD_NO_COLLISION_12 = []OLD_NO_COLLISION_12

assert OLD_NO_COLLISION_21 = (drone[2].arrive[OldX][OldY][1] -> X(![Drones].arrive[OldX][OldY][1] W {drone[2].arrive[OldX][OldY][OldH], drone[2].land}))
ltl_property P_OLD_NO_COLLISION_21 = []OLD_NO_COLLISION_21
assert OLD_NO_COLLISION_22 = (drone[2].arrive[OldX][OldY][2] -> X(![Drones].arrive[OldX][OldY][2] W {drone[2].arrive[OldX][OldY][OldH], drone[2].land}))
ltl_property P_OLD_NO_COLLISION_22 = []OLD_NO_COLLISION_22

// New range boundary: the forbidden Y boundary moves outward to Y=3; X stays at X=2.
assert NEW_MOVE_LIMIT_1 = (!drone[1].arrive[NewLimitX][NewY][NewH])
assert NEW_MOVE_LIMIT_2 = (!drone[2].arrive[NewX][NewLimitY][NewH])
ltl_property P_NEW_MOVE_LIMIT_1 = []NEW_MOVE_LIMIT_1
ltl_property P_NEW_MOVE_LIMIT_2 = []NEW_MOVE_LIMIT_2

assert NEW_NO_COLLISION_11 = (drone[1].arrive[NewX][NewY][1] -> X(![Drones].arrive[NewX][NewY][1] W {drone[1].arrive[NewX][NewY][NewH], drone[1].land}))
ltl_property P_NEW_NO_COLLISION_11 = []NEW_NO_COLLISION_11
assert NEW_NO_COLLISION_12 = (drone[1].arrive[NewX][NewY][2] -> X(![Drones].arrive[NewX][NewY][2] W {drone[1].arrive[NewX][NewY][NewH], drone[1].land}))
ltl_property P_NEW_NO_COLLISION_12 = []NEW_NO_COLLISION_12

assert NEW_NO_COLLISION_21 = (drone[2].arrive[NewX][NewY][1] -> X(![Drones].arrive[NewX][NewY][1] W {drone[2].arrive[NewX][NewY][NewH], drone[2].land}))
ltl_property P_NEW_NO_COLLISION_21 = []NEW_NO_COLLISION_21
assert NEW_NO_COLLISION_22 = (drone[2].arrive[NewX][NewY][2] -> X(![Drones].arrive[NewX][NewY][2] W {drone[2].arrive[NewX][NewY][NewH], drone[2].land}))
ltl_property P_NEW_NO_COLLISION_22 = []NEW_NO_COLLISION_22

//*****************************************************************************
// Controllers
//*****************************************************************************

controllerSpec OLD_SPEC = {
	safety = {
			P_OLD_MOVE_LIMIT_1,
			P_LOW_BATTERY_LAND_1,
			P_LOW_BATTERY_UP_1,
			P_LOW_BATTERY_MOVE_X_1,
			P_LOW_BATTERY_MOVE_Y_1,
			P_OLD_NO_COLLISION_11,
			P_OLD_NO_COLLISION_12,
			P_OLD_MOVE_LIMIT_2,
			P_LOW_BATTERY_LAND_2,
			P_LOW_BATTERY_UP_2,
			P_LOW_BATTERY_MOVE_X_2,
			P_LOW_BATTERY_MOVE_Y_2,
			P_OLD_NO_COLLISION_21,
			P_OLD_NO_COLLISION_22
	}
	controllable = {ControllableActions}
}
controller ||C_OLD_DRONE = (OLD_ENV)~{OLD_SPEC}.
||OldDrone = (C_OLD_DRONE || OLD_ENV).

controllerSpec NEW_SPEC = {
	safety = {
			P_NEW_MOVE_LIMIT_1,
			P_LOW_BATTERY_LAND_1,
			P_LOW_BATTERY_UP_1,
			P_LOW_BATTERY_MOVE_X_1,
			P_LOW_BATTERY_MOVE_Y_1,
			P_NEW_NO_COLLISION_11,
			P_NEW_NO_COLLISION_12,
			P_NEW_MOVE_LIMIT_2,
			P_LOW_BATTERY_LAND_2,
			P_LOW_BATTERY_UP_2,
			P_LOW_BATTERY_MOVE_X_2,
			P_LOW_BATTERY_MOVE_Y_2,
			P_NEW_NO_COLLISION_21,
			P_NEW_NO_COLLISION_22
	}
	controllable = {ControllableActions}
}
controller ||C_NEW_DRONE = (NEW_ENV)~{NEW_SPEC}.
||NewDrone = (C_NEW_DRONE || NEW_ENV).

//*****************************************************************************
// Updating controller requirements
//*****************************************************************************

fluent StopOldSpec = <stopOldSpec, hotSwapIn>
fluent StartNewSpec = <startNewSpec, hotSwapIn>
fluent Reconfigure = <reconfigure, hotSwapIn>

assert AllLanding = (LANDING[1] && LANDING[2])

// Traditional DUC: use boolean action assertions.
assert AnyAction_1 = (drone[1].battery['safe] || drone[1].takeoff || drone[1].land || drone[1].up || drone[1].down || drone[1].move['n] || drone[1].move['s] || drone[1].move['e] || drone[1].move['w])
assert AnyAction_2 = (drone[2].battery['safe] || drone[2].takeoff || drone[2].land || drone[2].up || drone[2].down || drone[2].move['n] || drone[2].move['s] || drone[2].move['e] || drone[2].move['w])
assert AnyAction = (AnyAction_1 || AnyAction_2)

// Only the Y dimension grows in the 2x3x2 update, so north is the extended move.
assert ExtendedMoveAction_1 = (drone[1].move['n])
assert ExtendedMoveAction_2 = (drone[2].move['n])
assert ExtendedMoveAction = (ExtendedMoveAction_1 || ExtendedMoveAction_2)

ltl_property T_NO_TP = ((StopOldSpec && !StartNewSpec) -> !AnyAction)
ltl_property T_UPDATE_WHILE_ALL_LANDED = (StartNewSpec -> AllLanding)
ltl_property T_START_NEW_BEFORE_EXTENDED_MOVE = ((StopOldSpec && !StartNewSpec) -> !ExtendedMoveAction)

updatingController UpdCont = {
	oldController = OldDrone,
	oldEnvironment = {BATTERY_OLD(1), MOVE_OLD(1), BATTERY_OLD(2), MOVE_OLD(2)},
	newEnvironment = {BATTERY_NEW(1), MOVE_NEW(1), BATTERY_NEW(2), MOVE_NEW(2)},
	mapRelation = {R_BATTERY(1), R_MOVE(1), R_BATTERY(2), R_MOVE(2)},
	oldGoal = OLD_SPEC,
	newGoal = NEW_SPEC,
//	transition = T_NO_TP,
//	transition = T_UPDATE_WHILE_ALL_LANDED,
	transition = T_START_NEW_BEFORE_EXTENDED_MOVE,
	nonblocking
}

||UPDATE_CONTROLLER = UpdCont.

updatingController UpdCont_SBP = {
	oldController = OldDrone,
	oldEnvironment = {BATTERY_OLD(1), MOVE_OLD(1), BATTERY_OLD(2), MOVE_OLD(2)},
	newEnvironment = {BATTERY_NEW(1), MOVE_NEW(1), BATTERY_NEW(2), MOVE_NEW(2)},
	mapRelation = {R_BATTERY(1), R_MOVE(1), R_BATTERY(2), R_MOVE(2)},
	oldGoal = OLD_SPEC,
	newGoal = NEW_SPEC,
//	transition = T_NO_TP,
//	transition = T_UPDATE_WHILE_ALL_LANDED,
	transition = T_START_NEW_BEFORE_EXTENDED_MOVE,
	nonblocking,
	safetyBackwardPruning
}

||UPDATE_CONTROLLER_SBP = UpdCont_SBP.

updatingController UpdCont_stepwise_delayed = {
	oldController = OldDrone,
	oldEnvironment = {BATTERY_OLD(1), MOVE_OLD(1), BATTERY_OLD(2), MOVE_OLD(2)},
	newEnvironment = {BATTERY_NEW(1), MOVE_NEW(1), BATTERY_NEW(2), MOVE_NEW(2)},
	mapRelation = {R_BATTERY(1), R_MOVE(1), R_BATTERY(2), R_MOVE(2)},
	oldGoal = OLD_SPEC,
	newGoal = NEW_SPEC,
//	transition = T_NO_TP,
//	transition = T_UPDATE_WHILE_ALL_LANDED,
	transition = T_START_NEW_BEFORE_EXTENDED_MOVE,
	nonblocking,
	stepwise_delayed
}

||STEPWISE_DELAYED_UPDATE_CONTROLLER = UpdCont_stepwise_delayed.

updatingController UpdCont_stepwise_delayed_SBP = {
	oldController = OldDrone,
	oldEnvironment = {BATTERY_OLD(1), MOVE_OLD(1), BATTERY_OLD(2), MOVE_OLD(2)},
	newEnvironment = {BATTERY_NEW(1), MOVE_NEW(1), BATTERY_NEW(2), MOVE_NEW(2)},
	mapRelation = {R_BATTERY(1), R_MOVE(1), R_BATTERY(2), R_MOVE(2)},
	oldGoal = OLD_SPEC,
	newGoal = NEW_SPEC,
//	transition = T_NO_TP,
//	transition = T_UPDATE_WHILE_ALL_LANDED,
	transition = T_START_NEW_BEFORE_EXTENDED_MOVE,
	nonblocking,
	stepwise_delayed,
	safetyBackwardPruning
}

||STEPWISE_DELAYED_UPDATE_CONTROLLER_SBP = UpdCont_stepwise_delayed_SBP.

//*****************************************************************************
// Test formulas
//*****************************************************************************

assert S_OLD = (OLD_MOVE_LIMIT_1 && LOW_BATTERY_LAND_1 && LOW_BATTERY_UP_1 && LOW_BATTERY_MOVE_X_1 && LOW_BATTERY_MOVE_Y_1 && OLD_MOVE_LIMIT_2 && LOW_BATTERY_LAND_2 && LOW_BATTERY_UP_2 && LOW_BATTERY_MOVE_X_2 && LOW_BATTERY_MOVE_Y_2 && OLD_NO_COLLISION_11 && OLD_NO_COLLISION_12 && OLD_NO_COLLISION_21 && OLD_NO_COLLISION_22)
assert S_NEW = (NEW_MOVE_LIMIT_1 && LOW_BATTERY_LAND_1 && LOW_BATTERY_UP_1 && LOW_BATTERY_MOVE_X_1 && LOW_BATTERY_MOVE_Y_1 && NEW_MOVE_LIMIT_2 && LOW_BATTERY_LAND_2 && LOW_BATTERY_UP_2 && LOW_BATTERY_MOVE_X_2 && LOW_BATTERY_MOVE_Y_2 && NEW_NO_COLLISION_11 && NEW_NO_COLLISION_12 && NEW_NO_COLLISION_21 && NEW_NO_COLLISION_22)

assert TEST_FORMULA1 = [](!StopOldSpec -> S_OLD)
assert TEST_FORMULA2 = [](StartNewSpec -> S_NEW)
assert TEST_FORMULA3 = [](hotSwapIn -> (<>stopOldSpec && <>startNewSpec && <>reconfigure))
