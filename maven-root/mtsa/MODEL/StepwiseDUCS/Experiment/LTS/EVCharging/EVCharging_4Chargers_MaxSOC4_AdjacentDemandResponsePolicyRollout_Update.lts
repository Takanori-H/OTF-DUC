// =============================================================================
// Demand-response fluents and safety requirements
// =============================================================================

fluent ABOVE_OLD_CHARGER_RATE_CAP[charger:Chargers] =
    <{[charger].startCharge[5], [charger].startCharge[6],
       [charger].setRate[5], [charger].setRate[6]},
     {[charger].setRate[1], [charger].setRate[2],
       [charger].setRate[3], [charger].setRate[4],
       [charger].pause, [charger].release,
       [charger].complete, [charger].disconnect}> initially 0

fluent ABOVE_NEW_CHARGER_RATE_CAP[charger:Chargers] =
    <{[charger].startCharge[3], [charger].startCharge[4],
       [charger].startCharge[5], [charger].startCharge[6],
       [charger].setRate[3], [charger].setRate[4],
       [charger].setRate[5], [charger].setRate[6]},
     {[charger].setRate[1], [charger].setRate[2],
       [charger].pause, [charger].release,
       [charger].complete, [charger].disconnect}> initially 0

fluent CHARGING[charger:Chargers] =
    <{[charger].startCharge[1], [charger].startCharge[2],
       [charger].startCharge[3], [charger].startCharge[4],
       [charger].startCharge[5], [charger].startCharge[6]},
     {[charger].pause, [charger].release,
       [charger].complete, [charger].disconnect}> initially 0

fluent AT_RATE_2[charger:Chargers] =
    <{[charger].startCharge[2], [charger].setRate[2]},
     {[charger].setRate[1], [charger].setRate[3],
       [charger].setRate[4], [charger].setRate[5], [charger].setRate[6],
       [charger].pause, [charger].release,
       [charger].complete, [charger].disconnect}> initially 0

ltl_property P_OLD_CHARGER_RATE_CAP_1 =
    [](!ABOVE_OLD_CHARGER_RATE_CAP['charger.[1]])
ltl_property P_OLD_CHARGER_RATE_CAP_2 =
    [](!ABOVE_OLD_CHARGER_RATE_CAP['charger.[2]])
ltl_property P_OLD_CHARGER_RATE_CAP_3 =
    [](!ABOVE_OLD_CHARGER_RATE_CAP['charger.[3]])
ltl_property P_OLD_CHARGER_RATE_CAP_4 =
    [](!ABOVE_OLD_CHARGER_RATE_CAP['charger.[4]])

controllerSpec OLD_REQ = {
    safety = {
        P_OLD_CHARGER_RATE_CAP_1,
        P_OLD_CHARGER_RATE_CAP_2,
        P_OLD_CHARGER_RATE_CAP_3,
        P_OLD_CHARGER_RATE_CAP_4
    }
    controllable = {ControllableActions}
}

controller ||OldController = (OLD_ENV)~{OLD_REQ}.
||OldCon = (OldController || OLD_ENV).

ltl_property P_NEW_CHARGER_RATE_CAP_1 =
    [](!ABOVE_NEW_CHARGER_RATE_CAP['charger.[1]])
ltl_property P_NEW_CHARGER_RATE_CAP_2 =
    [](!ABOVE_NEW_CHARGER_RATE_CAP['charger.[2]])
ltl_property P_NEW_CHARGER_RATE_CAP_3 =
    [](!ABOVE_NEW_CHARGER_RATE_CAP['charger.[3]])
ltl_property P_NEW_CHARGER_RATE_CAP_4 =
    [](!ABOVE_NEW_CHARGER_RATE_CAP['charger.[4]])

ltl_property P_NEW_ADJACENT_FEEDER_BUDGET_1_2 =
    [](!(
        (AT_RATE_2['charger.[1]] && CHARGING['charger.[2]]) ||
        (CHARGING['charger.[1]] && AT_RATE_2['charger.[2]])
    ))

ltl_property P_NEW_ADJACENT_FEEDER_BUDGET_2_3 =
    [](!(
        (AT_RATE_2['charger.[2]] && CHARGING['charger.[3]]) ||
        (CHARGING['charger.[2]] && AT_RATE_2['charger.[3]])
    ))

ltl_property P_NEW_ADJACENT_FEEDER_BUDGET_3_4 =
    [](!(
        (AT_RATE_2['charger.[3]] && CHARGING['charger.[4]]) ||
        (CHARGING['charger.[3]] && AT_RATE_2['charger.[4]])
    ))

controllerSpec NEW_REQ = {
    safety = {
        P_NEW_CHARGER_RATE_CAP_1,
        P_NEW_CHARGER_RATE_CAP_2,
        P_NEW_CHARGER_RATE_CAP_3,
        P_NEW_CHARGER_RATE_CAP_4,
        P_NEW_ADJACENT_FEEDER_BUDGET_1_2,
        P_NEW_ADJACENT_FEEDER_BUDGET_2_3,
        P_NEW_ADJACENT_FEEDER_BUDGET_3_4
    }
    controllable = {ControllableActions}
}

controller ||NewController = (NEW_ENV)~{NEW_REQ}.
||NewCon = (NewController || NEW_ENV).

// =============================================================================
// Transition requirements
// =============================================================================

fluent StopOldSpec = <stopOldSpec, hotSwapIn>
fluent StartNewSpec = <startNewSpec, hotSwapIn>
fluent Reconfigure = <reconfigure, hotSwapIn>

assert ANY_CONTROLLABLE_ACTION_CHARGER_1 = (
    charger[1].startCharge[1] || charger[1].startCharge[2] ||
    charger[1].startCharge[3] || charger[1].startCharge[4] ||
    charger[1].startCharge[5] || charger[1].startCharge[6] ||
    charger[1].setRate[1] || charger[1].setRate[2] ||
    charger[1].setRate[3] || charger[1].setRate[4] ||
    charger[1].setRate[5] || charger[1].setRate[6] ||
    charger[1].pause || charger[1].release
)

assert NO_CONTROLLABLE_ACTION_DURING_GAP_CHARGER_1 =
    ((StopOldSpec && !StartNewSpec) -> !ANY_CONTROLLABLE_ACTION_CHARGER_1)

ltl_property T1_NO_CONTROLLABLE_DURING_GAP_CHARGER_1 =
    NO_CONTROLLABLE_ACTION_DURING_GAP_CHARGER_1

assert ANY_CONTROLLABLE_ACTION_CHARGER_2 = (
    charger[2].startCharge[1] || charger[2].startCharge[2] ||
    charger[2].startCharge[3] || charger[2].startCharge[4] ||
    charger[2].startCharge[5] || charger[2].startCharge[6] ||
    charger[2].setRate[1] || charger[2].setRate[2] ||
    charger[2].setRate[3] || charger[2].setRate[4] ||
    charger[2].setRate[5] || charger[2].setRate[6] ||
    charger[2].pause || charger[2].release
)

assert NO_CONTROLLABLE_ACTION_DURING_GAP_CHARGER_2 =
    ((StopOldSpec && !StartNewSpec) -> !ANY_CONTROLLABLE_ACTION_CHARGER_2)

ltl_property T1_NO_CONTROLLABLE_DURING_GAP_CHARGER_2 =
    NO_CONTROLLABLE_ACTION_DURING_GAP_CHARGER_2

assert ANY_CONTROLLABLE_ACTION_CHARGER_3 = (
    charger[3].startCharge[1] || charger[3].startCharge[2] ||
    charger[3].startCharge[3] || charger[3].startCharge[4] ||
    charger[3].startCharge[5] || charger[3].startCharge[6] ||
    charger[3].setRate[1] || charger[3].setRate[2] ||
    charger[3].setRate[3] || charger[3].setRate[4] ||
    charger[3].setRate[5] || charger[3].setRate[6] ||
    charger[3].pause || charger[3].release
)

assert NO_CONTROLLABLE_ACTION_DURING_GAP_CHARGER_3 =
    ((StopOldSpec && !StartNewSpec) -> !ANY_CONTROLLABLE_ACTION_CHARGER_3)

ltl_property T1_NO_CONTROLLABLE_DURING_GAP_CHARGER_3 =
    NO_CONTROLLABLE_ACTION_DURING_GAP_CHARGER_3

assert ANY_CONTROLLABLE_ACTION_CHARGER_4 = (
    charger[4].startCharge[1] || charger[4].startCharge[2] ||
    charger[4].startCharge[3] || charger[4].startCharge[4] ||
    charger[4].startCharge[5] || charger[4].startCharge[6] ||
    charger[4].setRate[1] || charger[4].setRate[2] ||
    charger[4].setRate[3] || charger[4].setRate[4] ||
    charger[4].setRate[5] || charger[4].setRate[6] ||
    charger[4].pause || charger[4].release
)

assert NO_CONTROLLABLE_ACTION_DURING_GAP_CHARGER_4 =
    ((StopOldSpec && !StartNewSpec) -> !ANY_CONTROLLABLE_ACTION_CHARGER_4)

ltl_property T1_NO_CONTROLLABLE_DURING_GAP_CHARGER_4 =
    NO_CONTROLLABLE_ACTION_DURING_GAP_CHARGER_4

ltl_property T2_START_AFTER_STOP_AND_RECONFIGURE =
    (startNewSpec -> (StopOldSpec && Reconfigure))

// =============================================================================
// Updating-controller targets: no_tr, T1, and T2
// =============================================================================

updatingController UpdCont = {
    oldController = OldCon,
    oldEnvironment = {
        EV_CHARGER_OLD(1), EV_CHARGER_OLD(2),
        EV_CHARGER_OLD(3), EV_CHARGER_OLD(4)
    },
    newEnvironment = {
        EV_CHARGER_NEW(1), EV_CHARGER_NEW(2),
        EV_CHARGER_NEW(3), EV_CHARGER_NEW(4)
    },
    mapRelation = {R_CHARGER_1, R_CHARGER_2, R_CHARGER_3, R_CHARGER_4},
    oldGoal = OLD_REQ,
    newGoal = NEW_REQ,
    nonblocking
}

||EV_CHARGING_DEMAND_RESPONSE_TRADITIONAL = UpdCont.

updatingController UpdCont_T1 = {
    oldController = OldCon,
    oldEnvironment = {
        EV_CHARGER_OLD(1), EV_CHARGER_OLD(2),
        EV_CHARGER_OLD(3), EV_CHARGER_OLD(4)
    },
    newEnvironment = {
        EV_CHARGER_NEW(1), EV_CHARGER_NEW(2),
        EV_CHARGER_NEW(3), EV_CHARGER_NEW(4)
    },
    mapRelation = {R_CHARGER_1, R_CHARGER_2, R_CHARGER_3, R_CHARGER_4},
    oldGoal = OLD_REQ,
    newGoal = NEW_REQ,
    transition = T1_NO_CONTROLLABLE_DURING_GAP_CHARGER_1,
    transition = T1_NO_CONTROLLABLE_DURING_GAP_CHARGER_2,
    transition = T1_NO_CONTROLLABLE_DURING_GAP_CHARGER_3,
    transition = T1_NO_CONTROLLABLE_DURING_GAP_CHARGER_4,
    nonblocking
}

||EV_CHARGING_DEMAND_RESPONSE_T1_TRADITIONAL = UpdCont_T1.

updatingController UpdCont_T2 = {
    oldController = OldCon,
    oldEnvironment = {
        EV_CHARGER_OLD(1), EV_CHARGER_OLD(2),
        EV_CHARGER_OLD(3), EV_CHARGER_OLD(4)
    },
    newEnvironment = {
        EV_CHARGER_NEW(1), EV_CHARGER_NEW(2),
        EV_CHARGER_NEW(3), EV_CHARGER_NEW(4)
    },
    mapRelation = {R_CHARGER_1, R_CHARGER_2, R_CHARGER_3, R_CHARGER_4},
    oldGoal = OLD_REQ,
    newGoal = NEW_REQ,
    transition = T2_START_AFTER_STOP_AND_RECONFIGURE,
    nonblocking
}

||EV_CHARGING_DEMAND_RESPONSE_T2_TRADITIONAL = UpdCont_T2.

updatingController Stepwise_UpdCont = {
    oldController = OldCon,
    oldEnvironment = {
        EV_CHARGER_OLD(1), EV_CHARGER_OLD(2),
        EV_CHARGER_OLD(3), EV_CHARGER_OLD(4)
    },
    newEnvironment = {
        EV_CHARGER_NEW(1), EV_CHARGER_NEW(2),
        EV_CHARGER_NEW(3), EV_CHARGER_NEW(4)
    },
    mapRelation = {R_CHARGER_1, R_CHARGER_2, R_CHARGER_3, R_CHARGER_4},
    oldGoal = OLD_REQ,
    newGoal = NEW_REQ,
    nonblocking,
    stepwise_delayed,
    safetyBackwardPruning
}

||EV_CHARGING_DEMAND_RESPONSE_STEPWISE = Stepwise_UpdCont.

updatingController Stepwise_UpdCont_T1 = {
    oldController = OldCon,
    oldEnvironment = {
        EV_CHARGER_OLD(1), EV_CHARGER_OLD(2),
        EV_CHARGER_OLD(3), EV_CHARGER_OLD(4)
    },
    newEnvironment = {
        EV_CHARGER_NEW(1), EV_CHARGER_NEW(2),
        EV_CHARGER_NEW(3), EV_CHARGER_NEW(4)
    },
    mapRelation = {R_CHARGER_1, R_CHARGER_2, R_CHARGER_3, R_CHARGER_4},
    oldGoal = OLD_REQ,
    newGoal = NEW_REQ,
    transition = T1_NO_CONTROLLABLE_DURING_GAP_CHARGER_1,
    transition = T1_NO_CONTROLLABLE_DURING_GAP_CHARGER_2,
    transition = T1_NO_CONTROLLABLE_DURING_GAP_CHARGER_3,
    transition = T1_NO_CONTROLLABLE_DURING_GAP_CHARGER_4,
    nonblocking,
    stepwise_delayed,
    safetyBackwardPruning
}

||EV_CHARGING_DEMAND_RESPONSE_T1_STEPWISE = Stepwise_UpdCont_T1.

updatingController Stepwise_UpdCont_T2 = {
    oldController = OldCon,
    oldEnvironment = {
        EV_CHARGER_OLD(1), EV_CHARGER_OLD(2),
        EV_CHARGER_OLD(3), EV_CHARGER_OLD(4)
    },
    newEnvironment = {
        EV_CHARGER_NEW(1), EV_CHARGER_NEW(2),
        EV_CHARGER_NEW(3), EV_CHARGER_NEW(4)
    },
    mapRelation = {R_CHARGER_1, R_CHARGER_2, R_CHARGER_3, R_CHARGER_4},
    oldGoal = OLD_REQ,
    newGoal = NEW_REQ,
    transition = T2_START_AFTER_STOP_AND_RECONFIGURE,
    nonblocking,
    stepwise_delayed,
    safetyBackwardPruning
}

||EV_CHARGING_DEMAND_RESPONSE_T2_STEPWISE = Stepwise_UpdCont_T2.
