// EV-charging Stepwise DUCS model: adjacent demand-response policy rollout
// with an expanded MaxSOC=4 state space.
//
// Direct scaling source (left unchanged):
//   EVCharging_4Chargers_AdjacentDemandResponsePolicyRollout_Update.lts
//   SHA-256: 20cfaa3c1b90bc402d25256da6d7bc6c3dc3f4a5592302badfcd4cdb99cca467
//
// This N=4, MaxSOC=4 model changes only the SOC range and the resulting
// total identity relations.  It preserves the source model's charger behavior,
// MaxRate, action controllability, OLD/NEW policies, release followed by
// uncontrollable disconnect protocol, component structure, and requirement
// scopes.
//
// System meaning:
// - Four EV chargers serve independently connected vehicles.
// - connect, socIncrease, complete, and disconnect are uncontrollable events.
// - startCharge, setRate, pause, and release are controllable events.
// - A charging-rate level is an abstract power unit, not elapsed time.
// - socIncrease raises the vehicle SOC while preserving the selected rate.
// - complete finishes the last charging step and leaves the vehicle connected.
// - release opens the charger-side latch/contactor; the subsequent physical
//   disconnect remains uncontrollable.
// - OLD and NEW environments have exactly the same behavior.
// - Each charger is one mapping component with a total identity relation.
//
// Dynamic update meaning:
// - The OLD policy permits rate levels 1..4 independently at each charger.
// - The NEW policy restricts every charger locally to rate levels 1..2.
// - Adjacent charger pairs {1,2}, {2,3}, and {3,4} each have a combined active
//   rate budget of at most 2.  Therefore (1,1) is allowed within a pair,
//   whereas (1,2), (2,1), and (2,2) are not.
// - A charger that is connected but paused contributes no active rate.
//
// Expected Stepwise scopes:
// - P_OLD_CHARGER_RATE_CAP_i: {i}
// - P_NEW_CHARGER_RATE_CAP_i: {i}
// - P_NEW_ADJACENT_FEEDER_BUDGET_1_2: {1,2}
// - P_NEW_ADJACENT_FEEDER_BUDGET_2_3: {2,3}
// - P_NEW_ADJACENT_FEEDER_BUDGET_3_4: {3,4}
// - T1_NO_CONTROLLABLE_DURING_GAP_CHARGER_i: {i}
// - T2_START_AFTER_STOP_AND_RECONFIGURE: {1,2,3,4} (update events only)
//
// N=4, MaxSOC=4, and MaxRate=6.  Each charger has 31 states: VACANT,
// RELEASED, five CONNECTED states, and twenty-four CHARGING states.

// =============================================================================
// Constants and action classification
// =============================================================================

const N = 4
const MaxSOC = 4
const MaxRate = 6
const LastChargeableSOC = MaxSOC - 1

range ChargerID = 1..N
range SOC = 0..MaxSOC
range ChargeableSOC = 0..LastChargeableSOC
range Rate = 1..MaxRate

set Chargers = {charger[ChargerID]}

set ControllableActions = {
    [Chargers].startCharge[Rate],
    [Chargers].setRate[Rate],
    [Chargers].pause,
    [Chargers].release
}

// =============================================================================
// OLD and NEW environments
// =============================================================================

EV_CHARGER_OLD(I=1) = VACANT_OLD,
VACANT_OLD = (
    charger[I].connect -> CONNECTED_OLD[0]
),
CONNECTED_OLD[s:SOC] = (
      when (s < MaxSOC)
          charger[I].startCharge[rate:Rate] -> CHARGING_OLD[s][rate]
    | charger[I].release -> RELEASED_OLD
),
CHARGING_OLD[s:ChargeableSOC][current:Rate] = (
      when (s < LastChargeableSOC)
          charger[I].socIncrease -> CHARGING_OLD[s+1][current]
    | when (s == LastChargeableSOC)
          charger[I].complete -> CONNECTED_OLD[MaxSOC]
    | charger[I].setRate[next:Rate] -> CHARGING_OLD[s][next]
    | charger[I].pause -> CONNECTED_OLD[s]
    | charger[I].release -> RELEASED_OLD
),
RELEASED_OLD = (
    charger[I].disconnect -> VACANT_OLD
).

EV_CHARGER_NEW(I=1) = VACANT_NEW,
VACANT_NEW = (
    charger[I].connect -> CONNECTED_NEW[0]
),
CONNECTED_NEW[s:SOC] = (
      when (s < MaxSOC)
          charger[I].startCharge[rate:Rate] -> CHARGING_NEW[s][rate]
    | charger[I].release -> RELEASED_NEW
),
CHARGING_NEW[s:ChargeableSOC][current:Rate] = (
      when (s < LastChargeableSOC)
          charger[I].socIncrease -> CHARGING_NEW[s+1][current]
    | when (s == LastChargeableSOC)
          charger[I].complete -> CONNECTED_NEW[MaxSOC]
    | charger[I].setRate[next:Rate] -> CHARGING_NEW[s][next]
    | charger[I].pause -> CONNECTED_NEW[s]
    | charger[I].release -> RELEASED_NEW
),
RELEASED_NEW = (
    charger[I].disconnect -> VACANT_NEW
).

||OLD_ENV = (
    EV_CHARGER_OLD(1) || EV_CHARGER_OLD(2) ||
    EV_CHARGER_OLD(3) || EV_CHARGER_OLD(4)
).

||NEW_ENV = (
    EV_CHARGER_NEW(1) || EV_CHARGER_NEW(2) ||
    EV_CHARGER_NEW(3) || EV_CHARGER_NEW(4)
).

// =============================================================================
// Total identity state correspondence: one mapping component per charger
// =============================================================================

relation R_CHARGER_1 = {
    VACANT_OLD@EV_CHARGER_OLD(1) = reconfigure -> VACANT_NEW@EV_CHARGER_NEW(1),
    RELEASED_OLD@EV_CHARGER_OLD(1) = reconfigure -> RELEASED_NEW@EV_CHARGER_NEW(1),
    CONNECTED_OLD[0]@EV_CHARGER_OLD(1) = reconfigure -> CONNECTED_NEW[0]@EV_CHARGER_NEW(1),
    CONNECTED_OLD[1]@EV_CHARGER_OLD(1) = reconfigure -> CONNECTED_NEW[1]@EV_CHARGER_NEW(1),
    CONNECTED_OLD[2]@EV_CHARGER_OLD(1) = reconfigure -> CONNECTED_NEW[2]@EV_CHARGER_NEW(1),
    CONNECTED_OLD[3]@EV_CHARGER_OLD(1) = reconfigure -> CONNECTED_NEW[3]@EV_CHARGER_NEW(1),
    CONNECTED_OLD[4]@EV_CHARGER_OLD(1) = reconfigure -> CONNECTED_NEW[4]@EV_CHARGER_NEW(1),
    CHARGING_OLD[0][1]@EV_CHARGER_OLD(1) = reconfigure -> CHARGING_NEW[0][1]@EV_CHARGER_NEW(1),
    CHARGING_OLD[0][2]@EV_CHARGER_OLD(1) = reconfigure -> CHARGING_NEW[0][2]@EV_CHARGER_NEW(1),
    CHARGING_OLD[0][3]@EV_CHARGER_OLD(1) = reconfigure -> CHARGING_NEW[0][3]@EV_CHARGER_NEW(1),
    CHARGING_OLD[0][4]@EV_CHARGER_OLD(1) = reconfigure -> CHARGING_NEW[0][4]@EV_CHARGER_NEW(1),
    CHARGING_OLD[0][5]@EV_CHARGER_OLD(1) = reconfigure -> CHARGING_NEW[0][5]@EV_CHARGER_NEW(1),
    CHARGING_OLD[0][6]@EV_CHARGER_OLD(1) = reconfigure -> CHARGING_NEW[0][6]@EV_CHARGER_NEW(1),
    CHARGING_OLD[1][1]@EV_CHARGER_OLD(1) = reconfigure -> CHARGING_NEW[1][1]@EV_CHARGER_NEW(1),
    CHARGING_OLD[1][2]@EV_CHARGER_OLD(1) = reconfigure -> CHARGING_NEW[1][2]@EV_CHARGER_NEW(1),
    CHARGING_OLD[1][3]@EV_CHARGER_OLD(1) = reconfigure -> CHARGING_NEW[1][3]@EV_CHARGER_NEW(1),
    CHARGING_OLD[1][4]@EV_CHARGER_OLD(1) = reconfigure -> CHARGING_NEW[1][4]@EV_CHARGER_NEW(1),
    CHARGING_OLD[1][5]@EV_CHARGER_OLD(1) = reconfigure -> CHARGING_NEW[1][5]@EV_CHARGER_NEW(1),
    CHARGING_OLD[1][6]@EV_CHARGER_OLD(1) = reconfigure -> CHARGING_NEW[1][6]@EV_CHARGER_NEW(1),
    CHARGING_OLD[2][1]@EV_CHARGER_OLD(1) = reconfigure -> CHARGING_NEW[2][1]@EV_CHARGER_NEW(1),
    CHARGING_OLD[2][2]@EV_CHARGER_OLD(1) = reconfigure -> CHARGING_NEW[2][2]@EV_CHARGER_NEW(1),
    CHARGING_OLD[2][3]@EV_CHARGER_OLD(1) = reconfigure -> CHARGING_NEW[2][3]@EV_CHARGER_NEW(1),
    CHARGING_OLD[2][4]@EV_CHARGER_OLD(1) = reconfigure -> CHARGING_NEW[2][4]@EV_CHARGER_NEW(1),
    CHARGING_OLD[2][5]@EV_CHARGER_OLD(1) = reconfigure -> CHARGING_NEW[2][5]@EV_CHARGER_NEW(1),
    CHARGING_OLD[2][6]@EV_CHARGER_OLD(1) = reconfigure -> CHARGING_NEW[2][6]@EV_CHARGER_NEW(1),
    CHARGING_OLD[3][1]@EV_CHARGER_OLD(1) = reconfigure -> CHARGING_NEW[3][1]@EV_CHARGER_NEW(1),
    CHARGING_OLD[3][2]@EV_CHARGER_OLD(1) = reconfigure -> CHARGING_NEW[3][2]@EV_CHARGER_NEW(1),
    CHARGING_OLD[3][3]@EV_CHARGER_OLD(1) = reconfigure -> CHARGING_NEW[3][3]@EV_CHARGER_NEW(1),
    CHARGING_OLD[3][4]@EV_CHARGER_OLD(1) = reconfigure -> CHARGING_NEW[3][4]@EV_CHARGER_NEW(1),
    CHARGING_OLD[3][5]@EV_CHARGER_OLD(1) = reconfigure -> CHARGING_NEW[3][5]@EV_CHARGER_NEW(1),
    CHARGING_OLD[3][6]@EV_CHARGER_OLD(1) = reconfigure -> CHARGING_NEW[3][6]@EV_CHARGER_NEW(1)
}

