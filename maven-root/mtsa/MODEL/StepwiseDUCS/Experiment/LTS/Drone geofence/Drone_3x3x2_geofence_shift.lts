//******************************************************************************
//* Drone policy update in a fixed 3x3x2 airspace: geofence relocation
//*
//* Old geofence : voxel (3,3,2) is forbidden.
//* New geofence : voxel (1,3,2) is forbidden.
//*
//* The relocation rule generalizes the 2x2x2 example: the forbidden voxel
//* moves from (MaxX,MaxY,2) to (1,MaxY,2).
//*
//* hotSwapIn is intentionally not guarded by the geofence-ready condition.
//* It must remain enabled in every pre-update state.  If a drone occupies the
//* new forbidden voxel, the update controller first moves it out while the old
//* specification is still active.  Reconfiguration is allowed only after both
//* drones are outside the new geofence.
//******************************************************************************

//******************************************************************************
//* Constants and action sets
//******************************************************************************

const N = 2
const MaxX = 3
const MaxY = 3
const MaxH = 2

range DroneID = 1..N
set Drones = {drone[DroneID]}
range X = 1..MaxX
range Y = 1..MaxY
range H = 1..MaxH

set Direction = {n,s,e,w}
set DroneActions = {drone[DroneID].takeoff, drone[DroneID].land, drone[DroneID].up, drone[DroneID].down, drone[DroneID].move[Direction]}
set ControllableActions = {DroneActions}

// This focused benchmark omits the unchanged battery subsystem so that the
// measured difference comes from the policy update and local/cross pruning.

//******************************************************************************
//* Old and new environments.  Their transition structures are identical.
//******************************************************************************

MOVE_OLD(I=1) =
	(drone[I].takeoff -> drone[I].arrive[1][1][1] -> ACTION_OLD[1][1][1]),
ACTION_OLD[x:X][y:Y][h:H] =
	(when(x > 1)    drone[I].move['w] -> drone[I].arrive[x-1][y][h] -> ACTION_OLD[x-1][y][h]
	|when(x < MaxX) drone[I].move['e] -> drone[I].arrive[x+1][y][h] -> ACTION_OLD[x+1][y][h]
	|when(y > 1)    drone[I].move['s] -> drone[I].arrive[x][y-1][h] -> ACTION_OLD[x][y-1][h]
	|when(y < MaxY) drone[I].move['n] -> drone[I].arrive[x][y+1][h] -> ACTION_OLD[x][y+1][h]
	|when(h > 1)    drone[I].down      -> drone[I].arrive[x][y][h-1] -> ACTION_OLD[x][y][h-1]
	|when(h < MaxH) drone[I].up        -> drone[I].arrive[x][y][h+1] -> ACTION_OLD[x][y][h+1]
	|when(h == 1)   drone[I].land      -> MOVE_OLD).

MOVE_NEW(I=1) =
	(drone[I].takeoff -> drone[I].arrive[1][1][1] -> ACTION_NEW[1][1][1]),
ACTION_NEW[x:X][y:Y][h:H] =
	(when(x > 1)    drone[I].move['w] -> drone[I].arrive[x-1][y][h] -> ACTION_NEW[x-1][y][h]
	|when(x < MaxX) drone[I].move['e] -> drone[I].arrive[x+1][y][h] -> ACTION_NEW[x+1][y][h]
	|when(y > 1)    drone[I].move['s] -> drone[I].arrive[x][y-1][h] -> ACTION_NEW[x][y-1][h]
	|when(y < MaxY) drone[I].move['n] -> drone[I].arrive[x][y+1][h] -> ACTION_NEW[x][y+1][h]
	|when(h > 1)    drone[I].down      -> drone[I].arrive[x][y][h-1] -> ACTION_NEW[x][y][h-1]
	|when(h < MaxH) drone[I].up        -> drone[I].arrive[x][y][h+1] -> ACTION_NEW[x][y][h+1]
	|when(h == 1)   drone[I].land      -> MOVE_NEW).

||OLD_MOVE_ENV = (forall[i:DroneID] MOVE_OLD(i)).
||OLD_ENV = OLD_MOVE_ENV.

||NEW_MOVE_ENV = (forall[i:DroneID] MOVE_NEW(i)).
||NEW_ENV = NEW_MOVE_ENV.

//******************************************************************************
//* Identity mapping: the current flight/position state is preserved.
//******************************************************************************

relation R_MOVE(I) = {
	MOVE_OLD@MOVE_OLD(I) = reconfigure -> MOVE_NEW@MOVE_NEW(I),
	forall[x:X][y:Y][h:H]
		ACTION_OLD[x][y][h]@MOVE_OLD(I) = reconfigure -> ACTION_NEW[x][y][h]@MOVE_NEW(I)
}

//******************************************************************************
//* Shared exact-voxel collision avoidance
//******************************************************************************

fluent OCC_1_1_1_1 = <drone[1].arrive[1][1][1], {drone[1].move['n], drone[1].move['s], drone[1].move['e], drone[1].move['w], drone[1].up, drone[1].down, drone[1].land}>
fluent OCC_1_1_1_2 = <drone[1].arrive[1][1][2], {drone[1].move['n], drone[1].move['s], drone[1].move['e], drone[1].move['w], drone[1].up, drone[1].down, drone[1].land}>
fluent OCC_1_1_2_1 = <drone[1].arrive[1][2][1], {drone[1].move['n], drone[1].move['s], drone[1].move['e], drone[1].move['w], drone[1].up, drone[1].down, drone[1].land}>
fluent OCC_1_1_2_2 = <drone[1].arrive[1][2][2], {drone[1].move['n], drone[1].move['s], drone[1].move['e], drone[1].move['w], drone[1].up, drone[1].down, drone[1].land}>
fluent OCC_1_1_3_1 = <drone[1].arrive[1][3][1], {drone[1].move['n], drone[1].move['s], drone[1].move['e], drone[1].move['w], drone[1].up, drone[1].down, drone[1].land}>
fluent OCC_1_1_3_2 = <drone[1].arrive[1][3][2], {drone[1].move['n], drone[1].move['s], drone[1].move['e], drone[1].move['w], drone[1].up, drone[1].down, drone[1].land}>
fluent OCC_1_2_1_1 = <drone[1].arrive[2][1][1], {drone[1].move['n], drone[1].move['s], drone[1].move['e], drone[1].move['w], drone[1].up, drone[1].down, drone[1].land}>
fluent OCC_1_2_1_2 = <drone[1].arrive[2][1][2], {drone[1].move['n], drone[1].move['s], drone[1].move['e], drone[1].move['w], drone[1].up, drone[1].down, drone[1].land}>
fluent OCC_1_2_2_1 = <drone[1].arrive[2][2][1], {drone[1].move['n], drone[1].move['s], drone[1].move['e], drone[1].move['w], drone[1].up, drone[1].down, drone[1].land}>
fluent OCC_1_2_2_2 = <drone[1].arrive[2][2][2], {drone[1].move['n], drone[1].move['s], drone[1].move['e], drone[1].move['w], drone[1].up, drone[1].down, drone[1].land}>
fluent OCC_1_2_3_1 = <drone[1].arrive[2][3][1], {drone[1].move['n], drone[1].move['s], drone[1].move['e], drone[1].move['w], drone[1].up, drone[1].down, drone[1].land}>
fluent OCC_1_2_3_2 = <drone[1].arrive[2][3][2], {drone[1].move['n], drone[1].move['s], drone[1].move['e], drone[1].move['w], drone[1].up, drone[1].down, drone[1].land}>
fluent OCC_1_3_1_1 = <drone[1].arrive[3][1][1], {drone[1].move['n], drone[1].move['s], drone[1].move['e], drone[1].move['w], drone[1].up, drone[1].down, drone[1].land}>
fluent OCC_1_3_1_2 = <drone[1].arrive[3][1][2], {drone[1].move['n], drone[1].move['s], drone[1].move['e], drone[1].move['w], drone[1].up, drone[1].down, drone[1].land}>
fluent OCC_1_3_2_1 = <drone[1].arrive[3][2][1], {drone[1].move['n], drone[1].move['s], drone[1].move['e], drone[1].move['w], drone[1].up, drone[1].down, drone[1].land}>
fluent OCC_1_3_2_2 = <drone[1].arrive[3][2][2], {drone[1].move['n], drone[1].move['s], drone[1].move['e], drone[1].move['w], drone[1].up, drone[1].down, drone[1].land}>
fluent OCC_1_3_3_1 = <drone[1].arrive[3][3][1], {drone[1].move['n], drone[1].move['s], drone[1].move['e], drone[1].move['w], drone[1].up, drone[1].down, drone[1].land}>
fluent OCC_1_3_3_2 = <drone[1].arrive[3][3][2], {drone[1].move['n], drone[1].move['s], drone[1].move['e], drone[1].move['w], drone[1].up, drone[1].down, drone[1].land}>

fluent OCC_2_1_1_1 = <drone[2].arrive[1][1][1], {drone[2].move['n], drone[2].move['s], drone[2].move['e], drone[2].move['w], drone[2].up, drone[2].down, drone[2].land}>
fluent OCC_2_1_1_2 = <drone[2].arrive[1][1][2], {drone[2].move['n], drone[2].move['s], drone[2].move['e], drone[2].move['w], drone[2].up, drone[2].down, drone[2].land}>
fluent OCC_2_1_2_1 = <drone[2].arrive[1][2][1], {drone[2].move['n], drone[2].move['s], drone[2].move['e], drone[2].move['w], drone[2].up, drone[2].down, drone[2].land}>
fluent OCC_2_1_2_2 = <drone[2].arrive[1][2][2], {drone[2].move['n], drone[2].move['s], drone[2].move['e], drone[2].move['w], drone[2].up, drone[2].down, drone[2].land}>
fluent OCC_2_1_3_1 = <drone[2].arrive[1][3][1], {drone[2].move['n], drone[2].move['s], drone[2].move['e], drone[2].move['w], drone[2].up, drone[2].down, drone[2].land}>
fluent OCC_2_1_3_2 = <drone[2].arrive[1][3][2], {drone[2].move['n], drone[2].move['s], drone[2].move['e], drone[2].move['w], drone[2].up, drone[2].down, drone[2].land}>
fluent OCC_2_2_1_1 = <drone[2].arrive[2][1][1], {drone[2].move['n], drone[2].move['s], drone[2].move['e], drone[2].move['w], drone[2].up, drone[2].down, drone[2].land}>
fluent OCC_2_2_1_2 = <drone[2].arrive[2][1][2], {drone[2].move['n], drone[2].move['s], drone[2].move['e], drone[2].move['w], drone[2].up, drone[2].down, drone[2].land}>
fluent OCC_2_2_2_1 = <drone[2].arrive[2][2][1], {drone[2].move['n], drone[2].move['s], drone[2].move['e], drone[2].move['w], drone[2].up, drone[2].down, drone[2].land}>
fluent OCC_2_2_2_2 = <drone[2].arrive[2][2][2], {drone[2].move['n], drone[2].move['s], drone[2].move['e], drone[2].move['w], drone[2].up, drone[2].down, drone[2].land}>
fluent OCC_2_2_3_1 = <drone[2].arrive[2][3][1], {drone[2].move['n], drone[2].move['s], drone[2].move['e], drone[2].move['w], drone[2].up, drone[2].down, drone[2].land}>
fluent OCC_2_2_3_2 = <drone[2].arrive[2][3][2], {drone[2].move['n], drone[2].move['s], drone[2].move['e], drone[2].move['w], drone[2].up, drone[2].down, drone[2].land}>
fluent OCC_2_3_1_1 = <drone[2].arrive[3][1][1], {drone[2].move['n], drone[2].move['s], drone[2].move['e], drone[2].move['w], drone[2].up, drone[2].down, drone[2].land}>
fluent OCC_2_3_1_2 = <drone[2].arrive[3][1][2], {drone[2].move['n], drone[2].move['s], drone[2].move['e], drone[2].move['w], drone[2].up, drone[2].down, drone[2].land}>
fluent OCC_2_3_2_1 = <drone[2].arrive[3][2][1], {drone[2].move['n], drone[2].move['s], drone[2].move['e], drone[2].move['w], drone[2].up, drone[2].down, drone[2].land}>
fluent OCC_2_3_2_2 = <drone[2].arrive[3][2][2], {drone[2].move['n], drone[2].move['s], drone[2].move['e], drone[2].move['w], drone[2].up, drone[2].down, drone[2].land}>
fluent OCC_2_3_3_1 = <drone[2].arrive[3][3][1], {drone[2].move['n], drone[2].move['s], drone[2].move['e], drone[2].move['w], drone[2].up, drone[2].down, drone[2].land}>
fluent OCC_2_3_3_2 = <drone[2].arrive[3][3][2], {drone[2].move['n], drone[2].move['s], drone[2].move['e], drone[2].move['w], drone[2].up, drone[2].down, drone[2].land}>

assert NO_COLLISION_1_TO_2_H1 = (
	(OCC_1_1_1_1 -> !drone[2].arrive[1][1][1])
	&& (OCC_1_1_2_1 -> !drone[2].arrive[1][2][1])
	&& (OCC_1_1_3_1 -> !drone[2].arrive[1][3][1])
	&& (OCC_1_2_1_1 -> !drone[2].arrive[2][1][1])
	&& (OCC_1_2_2_1 -> !drone[2].arrive[2][2][1])
	&& (OCC_1_2_3_1 -> !drone[2].arrive[2][3][1])
	&& (OCC_1_3_1_1 -> !drone[2].arrive[3][1][1])
	&& (OCC_1_3_2_1 -> !drone[2].arrive[3][2][1])
	&& (OCC_1_3_3_1 -> !drone[2].arrive[3][3][1])
)
assert NO_COLLISION_1_TO_2_H2 = (
	(OCC_1_1_1_2 -> !drone[2].arrive[1][1][2])
	&& (OCC_1_1_2_2 -> !drone[2].arrive[1][2][2])
	&& (OCC_1_1_3_2 -> !drone[2].arrive[1][3][2])
	&& (OCC_1_2_1_2 -> !drone[2].arrive[2][1][2])
	&& (OCC_1_2_2_2 -> !drone[2].arrive[2][2][2])
	&& (OCC_1_2_3_2 -> !drone[2].arrive[2][3][2])
	&& (OCC_1_3_1_2 -> !drone[2].arrive[3][1][2])
	&& (OCC_1_3_2_2 -> !drone[2].arrive[3][2][2])
	&& (OCC_1_3_3_2 -> !drone[2].arrive[3][3][2])
)

assert NO_COLLISION_2_TO_1_H1 = (
	(OCC_2_1_1_1 -> !drone[1].arrive[1][1][1])
	&& (OCC_2_1_2_1 -> !drone[1].arrive[1][2][1])
	&& (OCC_2_1_3_1 -> !drone[1].arrive[1][3][1])
	&& (OCC_2_2_1_1 -> !drone[1].arrive[2][1][1])
	&& (OCC_2_2_2_1 -> !drone[1].arrive[2][2][1])
	&& (OCC_2_2_3_1 -> !drone[1].arrive[2][3][1])
	&& (OCC_2_3_1_1 -> !drone[1].arrive[3][1][1])
	&& (OCC_2_3_2_1 -> !drone[1].arrive[3][2][1])
	&& (OCC_2_3_3_1 -> !drone[1].arrive[3][3][1])
)
assert NO_COLLISION_2_TO_1_H2 = (
	(OCC_2_1_1_2 -> !drone[1].arrive[1][1][2])
	&& (OCC_2_1_2_2 -> !drone[1].arrive[1][2][2])
	&& (OCC_2_1_3_2 -> !drone[1].arrive[1][3][2])
	&& (OCC_2_2_1_2 -> !drone[1].arrive[2][1][2])
	&& (OCC_2_2_2_2 -> !drone[1].arrive[2][2][2])
	&& (OCC_2_2_3_2 -> !drone[1].arrive[2][3][2])
	&& (OCC_2_3_1_2 -> !drone[1].arrive[3][1][2])
	&& (OCC_2_3_2_2 -> !drone[1].arrive[3][2][2])
	&& (OCC_2_3_3_2 -> !drone[1].arrive[3][3][2])
)

ltl_property P_NO_COLLISION_1_TO_2_H1 = []NO_COLLISION_1_TO_2_H1
ltl_property P_NO_COLLISION_1_TO_2_H2 = []NO_COLLISION_1_TO_2_H2
ltl_property P_NO_COLLISION_2_TO_1_H1 = []NO_COLLISION_2_TO_1_H1
ltl_property P_NO_COLLISION_2_TO_1_H2 = []NO_COLLISION_2_TO_1_H2

//******************************************************************************
//* Geofence policies
//******************************************************************************

// The old controller excludes (3,3,2); the new forbidden voxel is allowed.
assert OLD_GEOFENCE_1 = (!drone[1].arrive[3][3][2])
assert OLD_GEOFENCE_2 = (!drone[2].arrive[3][3][2])
ltl_property P_OLD_GEOFENCE_1 = []OLD_GEOFENCE_1
ltl_property P_OLD_GEOFENCE_2 = []OLD_GEOFENCE_2

// The new controller excludes (1,3,2); the old forbidden voxel is released.
assert NEW_GEOFENCE_1 = (!drone[1].arrive[1][3][2])
assert NEW_GEOFENCE_2 = (!drone[2].arrive[1][3][2])
ltl_property P_NEW_GEOFENCE_1 = []NEW_GEOFENCE_1
ltl_property P_NEW_GEOFENCE_2 = []NEW_GEOFENCE_2

//******************************************************************************
//* Static old and new controllers
//******************************************************************************

controllerSpec OLD_SPEC = {
	safety = {
		P_OLD_GEOFENCE_1,
		P_OLD_GEOFENCE_2,
		P_NO_COLLISION_1_TO_2_H1,
		P_NO_COLLISION_1_TO_2_H2,
		P_NO_COLLISION_2_TO_1_H1,
		P_NO_COLLISION_2_TO_1_H2
	}
	controllable = {ControllableActions}
}

controllerSpec NEW_SPEC = {
	safety = {
		P_NEW_GEOFENCE_1,
		P_NEW_GEOFENCE_2,
		P_NO_COLLISION_1_TO_2_H1,
		P_NO_COLLISION_1_TO_2_H2,
		P_NO_COLLISION_2_TO_1_H1,
		P_NO_COLLISION_2_TO_1_H2
	}
	controllable = {ControllableActions}
}

controller ||C_OLD_DRONE = (OLD_ENV)~{OLD_SPEC}.
||OldDrone = (C_OLD_DRONE || OLD_ENV).

controller ||C_NEW_DRONE = (NEW_ENV)~{NEW_SPEC}.
||NewDrone = (C_NEW_DRONE || NEW_ENV).

//******************************************************************************
//* Transition requirements
//******************************************************************************

fluent StopOldSpec = <stopOldSpec,hotSwapIn>
fluent StartNewSpec = <startNewSpec,hotSwapIn>
fluent Reconfigure = <reconfigure,hotSwapIn>

assert DRONE_1_CONTROLLABLE_ACTION =
(
	drone[1].takeoff || drone[1].land || drone[1].up || drone[1].down
	|| drone[1].move['n] || drone[1].move['s]
	|| drone[1].move['e] || drone[1].move['w]
)
assert DRONE_2_CONTROLLABLE_ACTION =
(
	drone[2].takeoff || drone[2].land || drone[2].up || drone[2].down
	|| drone[2].move['n] || drone[2].move['s]
	|| drone[2].move['e] || drone[2].move['w]
)
assert NO_CONTROLLABLE_ACTION_DURING_GAP_1 =
	((StopOldSpec && !StartNewSpec) -> !DRONE_1_CONTROLLABLE_ACTION)
assert NO_CONTROLLABLE_ACTION_DURING_GAP_2 =
	((StopOldSpec && !StartNewSpec) -> !DRONE_2_CONTROLLABLE_ACTION)

ltl_property T1_NO_CONTROLLABLE_DURING_GAP_1 = NO_CONTROLLABLE_ACTION_DURING_GAP_1
ltl_property T1_NO_CONTROLLABLE_DURING_GAP_2 = NO_CONTROLLABLE_ACTION_DURING_GAP_2
ltl_property T2_START_AFTER_STOP_AND_RECONFIGURE =
	(startNewSpec -> (StopOldSpec && Reconfigure))

//******************************************************************************
//* Updating controllers
//******************************************************************************

updatingController UpdCont = {
	oldController = OldDrone,
	oldEnvironment = {MOVE_OLD(1), MOVE_OLD(2)},
	newEnvironment = {MOVE_NEW(1), MOVE_NEW(2)},
	mapRelation = {R_MOVE(1), R_MOVE(2)},
	oldGoal = OLD_SPEC,
	newGoal = NEW_SPEC,
	nonblocking
}

||UPDATE_CONTROLLER = UpdCont.

updatingController UpdCont_T1 = {
	oldController = OldDrone,
	oldEnvironment = {MOVE_OLD(1), MOVE_OLD(2)},
	newEnvironment = {MOVE_NEW(1), MOVE_NEW(2)},
	mapRelation = {R_MOVE(1), R_MOVE(2)},
	oldGoal = OLD_SPEC,
	newGoal = NEW_SPEC,
	transition = T1_NO_CONTROLLABLE_DURING_GAP_1,
	transition = T1_NO_CONTROLLABLE_DURING_GAP_2,
	nonblocking
}

||UPDATE_CONTROLLER_T1 = UpdCont_T1.

updatingController UpdCont_T2 = {
	oldController = OldDrone,
	oldEnvironment = {MOVE_OLD(1), MOVE_OLD(2)},
	newEnvironment = {MOVE_NEW(1), MOVE_NEW(2)},
	mapRelation = {R_MOVE(1), R_MOVE(2)},
	oldGoal = OLD_SPEC,
	newGoal = NEW_SPEC,
	transition = T2_START_AFTER_STOP_AND_RECONFIGURE,
	nonblocking
}

||UPDATE_CONTROLLER_T2 = UpdCont_T2.

updatingController Stepwise_UpdCont = {
	oldController = OldDrone,
	oldEnvironment = {MOVE_OLD(1), MOVE_OLD(2)},
	newEnvironment = {MOVE_NEW(1), MOVE_NEW(2)},
	mapRelation = {R_MOVE(1), R_MOVE(2)},
	oldGoal = OLD_SPEC,
	newGoal = NEW_SPEC,
	nonblocking,
	stepwise_delayed,
	safetyBackwardPruning
}

||STEPWISE_UPDATE_CONTROLLER = Stepwise_UpdCont.

updatingController Stepwise_UpdCont_T1 = {
	oldController = OldDrone,
	oldEnvironment = {MOVE_OLD(1), MOVE_OLD(2)},
	newEnvironment = {MOVE_NEW(1), MOVE_NEW(2)},
	mapRelation = {R_MOVE(1), R_MOVE(2)},
	oldGoal = OLD_SPEC,
	newGoal = NEW_SPEC,
	transition = T1_NO_CONTROLLABLE_DURING_GAP_1,
	transition = T1_NO_CONTROLLABLE_DURING_GAP_2,
	nonblocking,
	stepwise_delayed,
	safetyBackwardPruning
}

||STEPWISE_UPDATE_CONTROLLER_T1 = Stepwise_UpdCont_T1.

updatingController Stepwise_UpdCont_T2 = {
	oldController = OldDrone,
	oldEnvironment = {MOVE_OLD(1), MOVE_OLD(2)},
	newEnvironment = {MOVE_NEW(1), MOVE_NEW(2)},
	mapRelation = {R_MOVE(1), R_MOVE(2)},
	oldGoal = OLD_SPEC,
	newGoal = NEW_SPEC,
	transition = T2_START_AFTER_STOP_AND_RECONFIGURE,
	nonblocking,
	stepwise_delayed,
	safetyBackwardPruning
}

||STEPWISE_UPDATE_CONTROLLER_T2 = Stepwise_UpdCont_T2.

// The CLI UpdateRequirementChecker can be used after synthesis to verify R1:
// hotSwapIn_enabled_in_all_pre_update_states.
