// ComputeCluster Stepwise DUCS model: N=4 strong thermal-derating update with T2.
//
// Direct base (left unchanged):
//   ComputeCluster_4Nodes_StrongThermalDerating_Update.lts
//   SHA-256: 973a23a1ee1ec9857701cdcc2247997668f22c6fd8aafb568d61bb0a07cd74cd
//
// This N=4 scaling keeps the system and update meaning of the N=2/N=3 models:
// - Each compute node supports performance levels 1..6.
// - OLD permits levels 1..4 and locally forbids levels 5..6.
// - NEW permits levels 1..2 and locally forbids levels 3..6.
// - The four nodes are physically arranged in a line. Under the NEW policy,
//   adjacent pairs (1,2), (2,3), and (3,4) may not both run at level 2.
// - Old and new environments are behaviorally identical.
// - There is one total identity mapping relation per node.
//
// Expected scopes:
// - Eight local cap requirements: {1}, {2}, {3}, or {4}.
// - Pairwise requirements: {1,2}, {2,3}, and {3,4}.
//
// T2 requires stopOldSpec and reconfigure to have occurred before startNewSpec.
// It references update events only and therefore has all-component scope.
// Traditional DUCS and non-incremental Stepwise DUCS + SBP receive identical T2 inputs.

// =============================================================================
// Constants and action classification
// =============================================================================

const N = 4
const MaxLevel = 6

range NodeID = 1..N
range Level = 1..MaxLevel
set Nodes = {node[NodeID]}

set ControllableActions = {
    [Nodes].start[Level],
    [Nodes].setLevel[Level],
    [Nodes].stop
}

// node[i].request and node[i].finish are uncontrollable.

// =============================================================================
// Old and new environments
// =============================================================================

NODE_OLD(I=1) = IDLE_OLD,
IDLE_OLD = (
    node[I].request -> READY_OLD
),
READY_OLD = (
      node[I].start[level:Level] -> RUN_OLD[level]
    | node[I].stop -> IDLE_OLD
),
RUN_OLD[current:Level] = (
      node[I].setLevel[next:Level] -> RUN_OLD[next]
    | node[I].finish -> IDLE_OLD
    | node[I].stop -> IDLE_OLD
).

NODE_NEW(I=1) = IDLE_NEW,
IDLE_NEW = (
    node[I].request -> READY_NEW
),
READY_NEW = (
      node[I].start[level:Level] -> RUN_NEW[level]
    | node[I].stop -> IDLE_NEW
),
RUN_NEW[current:Level] = (
      node[I].setLevel[next:Level] -> RUN_NEW[next]
    | node[I].finish -> IDLE_NEW
    | node[I].stop -> IDLE_NEW
).

||OLD_ENV = (NODE_OLD(1) || NODE_OLD(2) || NODE_OLD(3) || NODE_OLD(4)).
||NEW_ENV = (NODE_NEW(1) || NODE_NEW(2) || NODE_NEW(3) || NODE_NEW(4)).

// =============================================================================
// Total identity state correspondence: one mapping component per node
// =============================================================================

relation R_NODE_1 = {
    IDLE_OLD@NODE_OLD(1) = reconfigure -> IDLE_NEW@NODE_NEW(1),
    READY_OLD@NODE_OLD(1) = reconfigure -> READY_NEW@NODE_NEW(1),
    RUN_OLD[1]@NODE_OLD(1) = reconfigure -> RUN_NEW[1]@NODE_NEW(1),
    RUN_OLD[2]@NODE_OLD(1) = reconfigure -> RUN_NEW[2]@NODE_NEW(1),
    RUN_OLD[3]@NODE_OLD(1) = reconfigure -> RUN_NEW[3]@NODE_NEW(1),
    RUN_OLD[4]@NODE_OLD(1) = reconfigure -> RUN_NEW[4]@NODE_NEW(1),
    RUN_OLD[5]@NODE_OLD(1) = reconfigure -> RUN_NEW[5]@NODE_NEW(1),
    RUN_OLD[6]@NODE_OLD(1) = reconfigure -> RUN_NEW[6]@NODE_NEW(1)
}

relation R_NODE_2 = {
    IDLE_OLD@NODE_OLD(2) = reconfigure -> IDLE_NEW@NODE_NEW(2),
    READY_OLD@NODE_OLD(2) = reconfigure -> READY_NEW@NODE_NEW(2),
    RUN_OLD[1]@NODE_OLD(2) = reconfigure -> RUN_NEW[1]@NODE_NEW(2),
    RUN_OLD[2]@NODE_OLD(2) = reconfigure -> RUN_NEW[2]@NODE_NEW(2),
    RUN_OLD[3]@NODE_OLD(2) = reconfigure -> RUN_NEW[3]@NODE_NEW(2),
    RUN_OLD[4]@NODE_OLD(2) = reconfigure -> RUN_NEW[4]@NODE_NEW(2),
    RUN_OLD[5]@NODE_OLD(2) = reconfigure -> RUN_NEW[5]@NODE_NEW(2),
    RUN_OLD[6]@NODE_OLD(2) = reconfigure -> RUN_NEW[6]@NODE_NEW(2)
}

relation R_NODE_3 = {
    IDLE_OLD@NODE_OLD(3) = reconfigure -> IDLE_NEW@NODE_NEW(3),
    READY_OLD@NODE_OLD(3) = reconfigure -> READY_NEW@NODE_NEW(3),
    RUN_OLD[1]@NODE_OLD(3) = reconfigure -> RUN_NEW[1]@NODE_NEW(3),
    RUN_OLD[2]@NODE_OLD(3) = reconfigure -> RUN_NEW[2]@NODE_NEW(3),
    RUN_OLD[3]@NODE_OLD(3) = reconfigure -> RUN_NEW[3]@NODE_NEW(3),
    RUN_OLD[4]@NODE_OLD(3) = reconfigure -> RUN_NEW[4]@NODE_NEW(3),
    RUN_OLD[5]@NODE_OLD(3) = reconfigure -> RUN_NEW[5]@NODE_NEW(3),
    RUN_OLD[6]@NODE_OLD(3) = reconfigure -> RUN_NEW[6]@NODE_NEW(3)
}

relation R_NODE_4 = {
    IDLE_OLD@NODE_OLD(4) = reconfigure -> IDLE_NEW@NODE_NEW(4),
    READY_OLD@NODE_OLD(4) = reconfigure -> READY_NEW@NODE_NEW(4),
    RUN_OLD[1]@NODE_OLD(4) = reconfigure -> RUN_NEW[1]@NODE_NEW(4),
    RUN_OLD[2]@NODE_OLD(4) = reconfigure -> RUN_NEW[2]@NODE_NEW(4),
    RUN_OLD[3]@NODE_OLD(4) = reconfigure -> RUN_NEW[3]@NODE_NEW(4),
    RUN_OLD[4]@NODE_OLD(4) = reconfigure -> RUN_NEW[4]@NODE_NEW(4),
    RUN_OLD[5]@NODE_OLD(4) = reconfigure -> RUN_NEW[5]@NODE_NEW(4),
    RUN_OLD[6]@NODE_OLD(4) = reconfigure -> RUN_NEW[6]@NODE_NEW(4)
}

// =============================================================================
// Thermal-policy fluents and safety requirements
// =============================================================================

fluent ABOVE_OLD_THERMAL_CAP[node:Nodes] =
    <{[node].start[5], [node].start[6],
       [node].setLevel[5], [node].setLevel[6]},
     {[node].setLevel[1], [node].setLevel[2],
       [node].setLevel[3], [node].setLevel[4],
       [node].finish, [node].stop}> initially 0

fluent ABOVE_NEW_THERMAL_CAP[node:Nodes] =
    <{[node].start[3], [node].start[4],
       [node].start[5], [node].start[6],
       [node].setLevel[3], [node].setLevel[4],
       [node].setLevel[5], [node].setLevel[6]},
     {[node].setLevel[1], [node].setLevel[2],
       [node].finish, [node].stop}> initially 0

fluent AT_LEVEL_2[node:Nodes] =
    <{[node].start[2], [node].setLevel[2]},
     {[node].setLevel[1], [node].setLevel[3],
       [node].setLevel[4], [node].setLevel[5], [node].setLevel[6],
       [node].finish, [node].stop}> initially 0

ltl_property P_OLD_THERMAL_CAP_1 = [](!ABOVE_OLD_THERMAL_CAP['node.[1]])
ltl_property P_OLD_THERMAL_CAP_2 = [](!ABOVE_OLD_THERMAL_CAP['node.[2]])
ltl_property P_OLD_THERMAL_CAP_3 = [](!ABOVE_OLD_THERMAL_CAP['node.[3]])
ltl_property P_OLD_THERMAL_CAP_4 = [](!ABOVE_OLD_THERMAL_CAP['node.[4]])

controllerSpec OLD_REQ = {
    safety = {
        P_OLD_THERMAL_CAP_1,
        P_OLD_THERMAL_CAP_2,
        P_OLD_THERMAL_CAP_3,
        P_OLD_THERMAL_CAP_4
    }
    controllable = {ControllableActions}
}

controller ||OldController = (OLD_ENV)~{OLD_REQ}.
||OldCon = (OldController || OLD_ENV).

ltl_property P_NEW_THERMAL_CAP_1 = [](!ABOVE_NEW_THERMAL_CAP['node.[1]])
ltl_property P_NEW_THERMAL_CAP_2 = [](!ABOVE_NEW_THERMAL_CAP['node.[2]])
ltl_property P_NEW_THERMAL_CAP_3 = [](!ABOVE_NEW_THERMAL_CAP['node.[3]])
ltl_property P_NEW_THERMAL_CAP_4 = [](!ABOVE_NEW_THERMAL_CAP['node.[4]])

ltl_property P_PAIRWISE_LEVEL_2_1_2_NEW =
    [](!(AT_LEVEL_2['node.[1]] && AT_LEVEL_2['node.[2]]))
ltl_property P_PAIRWISE_LEVEL_2_2_3_NEW =
    [](!(AT_LEVEL_2['node.[2]] && AT_LEVEL_2['node.[3]]))
ltl_property P_PAIRWISE_LEVEL_2_3_4_NEW =
    [](!(AT_LEVEL_2['node.[3]] && AT_LEVEL_2['node.[4]]))

controllerSpec NEW_REQ = {
    safety = {
        P_NEW_THERMAL_CAP_1,
        P_NEW_THERMAL_CAP_2,
        P_NEW_THERMAL_CAP_3,
        P_NEW_THERMAL_CAP_4,
        P_PAIRWISE_LEVEL_2_1_2_NEW,
        P_PAIRWISE_LEVEL_2_2_3_NEW,
        P_PAIRWISE_LEVEL_2_3_4_NEW
    }
    controllable = {ControllableActions}
}

controller ||NewController = (NEW_ENV)~{NEW_REQ}.
||NewCon = (NewController || NEW_ENV).

// =============================================================================
// T2: startNewSpec only after stopOldSpec and reconfigure
// =============================================================================

fluent StopOldSpec = <stopOldSpec, hotSwapIn>
fluent Reconfigured = <reconfigure, hotSwapIn>

ltl_property T2_START_AFTER_STOP_AND_RECONFIGURE =
    (startNewSpec -> (StopOldSpec && Reconfigured))

// =============================================================================
// Updating-controller targets: T2
// =============================================================================

updatingController UpdCont = {
    oldController = OldCon,
    oldEnvironment = {NODE_OLD(1), NODE_OLD(2), NODE_OLD(3), NODE_OLD(4)},
    newEnvironment = {NODE_NEW(1), NODE_NEW(2), NODE_NEW(3), NODE_NEW(4)},
    mapRelation = {R_NODE_1, R_NODE_2, R_NODE_3, R_NODE_4},
    oldGoal = OLD_REQ,
    newGoal = NEW_REQ,
    transition = T2_START_AFTER_STOP_AND_RECONFIGURE,
    nonblocking
}

||COMPUTE_CLUSTER_N4_STRONG_THERMAL_DERATING_T2_TRADITIONAL = UpdCont.

updatingController Stepwise_UpdCont = {
    oldController = OldCon,
    oldEnvironment = {NODE_OLD(1), NODE_OLD(2), NODE_OLD(3), NODE_OLD(4)},
    newEnvironment = {NODE_NEW(1), NODE_NEW(2), NODE_NEW(3), NODE_NEW(4)},
    mapRelation = {R_NODE_1, R_NODE_2, R_NODE_3, R_NODE_4},
    oldGoal = OLD_REQ,
    newGoal = NEW_REQ,
    transition = T2_START_AFTER_STOP_AND_RECONFIGURE,
    nonblocking,
    stepwise_delayed,
    safetyBackwardPruning
}

||COMPUTE_CLUSTER_N4_STRONG_THERMAL_DERATING_T2_STEPWISE = Stepwise_UpdCont.

