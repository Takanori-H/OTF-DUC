// ComputeCluster Stepwise DUCS model: strong thermal-derating policy update.
//
// This model was designed from scratch for Stepwise DUCS evaluation. It is not
// derived from ArtGallery, Drone, KIVA, or any existing update benchmark.
//
// Direct structural base (left unchanged):
//   ComputeCluster_2Nodes_LocalAndPairwiseThermal_Update.lts
//   SHA-256: 70c59497f9aa9be625e83b40ae4f0d5446fa25ffa1552c67afcf76d9d709130a
//
// System meaning:
// - Two adjacent compute nodes execute jobs at one of six hardware-supported
//   performance levels.
// - A job request and normal job completion are uncontrollable.
// - Starting, changing the performance level, and stopping are controllable.
// - Old and new environments have identical behavior and alphabets.
// - Each node is one mapping component. Every old state is related to the new
//   state with the same operational meaning.
//
// Update scenario:
// - Under normal cooling, the OLD policy permits levels 1..4 and locally
//   forbids levels 5..6.
// - After a substantial cooling-capacity loss, the NEW policy permits only
//   levels 1..2 and locally forbids levels 3..6.
// - The NEW policy also prevents the two adjacent nodes from operating at
//   level 2 simultaneously because of thermal coupling in the rack.
// - A node already at OLD-permitted level 3 or 4 can execute controllable
//   setLevel[1], setLevel[2], or stop before startNewSpec.
//
// Expected component scopes:
// - P_OLD_THERMAL_CAP_1 and P_NEW_THERMAL_CAP_1: {1}
// - P_OLD_THERMAL_CAP_2 and P_NEW_THERMAL_CAP_2: {2}
// - P_PAIRWISE_LEVEL_2_NEW: {1,2}
//
// The phase-separation properties from the diagnostic models are deliberately
// omitted because they are structurally invariant and did not prune states.
// Only no_tr Traditional DUCS and Stepwise DUCS targets are provided here.

// =============================================================================
// Constants and action classification
// =============================================================================

const N = 2
const MaxLevel = 6

range NodeID = 1..N
range Level = 1..MaxLevel
set Nodes = {node[NodeID]}

// Per node: start[1..6], setLevel[1..6], and stop are controllable.
set ControllableActions = {
    [Nodes].start[Level],
    [Nodes].setLevel[Level],
    [Nodes].stop
}

// node[i].request and node[i].finish are intentionally absent from the set
// above and are therefore uncontrollable.

// =============================================================================
// Old and new environments
// =============================================================================

// Each node has eight states: IDLE, READY, and RUN[level] for levels 1..6.
// All transitions are atomic; there is no command/arrival intermediate state.

NODE_OLD(I=1) = IDLE_OLD,
IDLE_OLD = (
    node[I].request -> READY_OLD
),
READY_OLD = (
      node[I].start[level:Level] -> RUN_OLD[level]
    | node[I].stop -> IDLE_OLD
),
RUN_OLD[current:Level] = (
      node[I].setLevel[next:Level] -> RUN_OLD[next]
    | node[I].finish -> IDLE_OLD
    | node[I].stop -> IDLE_OLD
).

NODE_NEW(I=1) = IDLE_NEW,
IDLE_NEW = (
    node[I].request -> READY_NEW
),
READY_NEW = (
      node[I].start[level:Level] -> RUN_NEW[level]
    | node[I].stop -> IDLE_NEW
),
RUN_NEW[current:Level] = (
      node[I].setLevel[next:Level] -> RUN_NEW[next]
    | node[I].finish -> IDLE_NEW
    | node[I].stop -> IDLE_NEW
).

||OLD_ENV = (NODE_OLD(1) || NODE_OLD(2)).
||NEW_ENV = (NODE_NEW(1) || NODE_NEW(2)).

// =============================================================================
// Total identity state correspondence: one mapping component per node
// =============================================================================

relation R_NODE_1 = {
    IDLE_OLD@NODE_OLD(1) = reconfigure -> IDLE_NEW@NODE_NEW(1),
    READY_OLD@NODE_OLD(1) = reconfigure -> READY_NEW@NODE_NEW(1),
    RUN_OLD[1]@NODE_OLD(1) = reconfigure -> RUN_NEW[1]@NODE_NEW(1),
    RUN_OLD[2]@NODE_OLD(1) = reconfigure -> RUN_NEW[2]@NODE_NEW(1),
    RUN_OLD[3]@NODE_OLD(1) = reconfigure -> RUN_NEW[3]@NODE_NEW(1),
    RUN_OLD[4]@NODE_OLD(1) = reconfigure -> RUN_NEW[4]@NODE_NEW(1),
    RUN_OLD[5]@NODE_OLD(1) = reconfigure -> RUN_NEW[5]@NODE_NEW(1),
    RUN_OLD[6]@NODE_OLD(1) = reconfigure -> RUN_NEW[6]@NODE_NEW(1)
}

relation R_NODE_2 = {
    IDLE_OLD@NODE_OLD(2) = reconfigure -> IDLE_NEW@NODE_NEW(2),
    READY_OLD@NODE_OLD(2) = reconfigure -> READY_NEW@NODE_NEW(2),
    RUN_OLD[1]@NODE_OLD(2) = reconfigure -> RUN_NEW[1]@NODE_NEW(2),
    RUN_OLD[2]@NODE_OLD(2) = reconfigure -> RUN_NEW[2]@NODE_NEW(2),
    RUN_OLD[3]@NODE_OLD(2) = reconfigure -> RUN_NEW[3]@NODE_NEW(2),
    RUN_OLD[4]@NODE_OLD(2) = reconfigure -> RUN_NEW[4]@NODE_NEW(2),
    RUN_OLD[5]@NODE_OLD(2) = reconfigure -> RUN_NEW[5]@NODE_NEW(2),
    RUN_OLD[6]@NODE_OLD(2) = reconfigure -> RUN_NEW[6]@NODE_NEW(2)
}

// =============================================================================
// Thermal-policy fluents and safety requirements
// =============================================================================

// Levels 5 and 6 exceed the OLD thermal cap. Lowering the level, normal
// completion, or stopping clears the violation condition.
fluent ABOVE_OLD_THERMAL_CAP[node:Nodes] =
    <{[node].start[5], [node].start[6],
       [node].setLevel[5], [node].setLevel[6]},
     {[node].setLevel[1], [node].setLevel[2],
       [node].setLevel[3], [node].setLevel[4],
       [node].finish, [node].stop}> initially 0

// Levels 3..6 exceed the stricter NEW thermal cap.
fluent ABOVE_NEW_THERMAL_CAP[node:Nodes] =
    <{[node].start[3], [node].start[4],
       [node].start[5], [node].start[6],
       [node].setLevel[3], [node].setLevel[4],
       [node].setLevel[5], [node].setLevel[6]},
     {[node].setLevel[1], [node].setLevel[2],
       [node].finish, [node].stop}> initially 0

// Exact level-2 occupancy for the NEW pairwise thermal-coupling policy.
fluent AT_LEVEL_2[node:Nodes] =
    <{[node].start[2], [node].setLevel[2]},
     {[node].setLevel[1], [node].setLevel[3],
       [node].setLevel[4], [node].setLevel[5], [node].setLevel[6],
       [node].finish, [node].stop}> initially 0

ltl_property P_OLD_THERMAL_CAP_1 = [](!ABOVE_OLD_THERMAL_CAP['node.[1]])
ltl_property P_OLD_THERMAL_CAP_2 = [](!ABOVE_OLD_THERMAL_CAP['node.[2]])

controllerSpec OLD_REQ = {
    safety = {
        P_OLD_THERMAL_CAP_1,
        P_OLD_THERMAL_CAP_2
    }
    controllable = {ControllableActions}
}

controller ||OldController = (OLD_ENV)~{OLD_REQ}.
||OldCon = (OldController || OLD_ENV).

ltl_property P_NEW_THERMAL_CAP_1 = [](!ABOVE_NEW_THERMAL_CAP['node.[1]])
ltl_property P_NEW_THERMAL_CAP_2 = [](!ABOVE_NEW_THERMAL_CAP['node.[2]])
ltl_property P_PAIRWISE_LEVEL_2_NEW =
    [](!(AT_LEVEL_2['node.[1]] && AT_LEVEL_2['node.[2]]))

controllerSpec NEW_REQ = {
    safety = {
        P_NEW_THERMAL_CAP_1,
        P_NEW_THERMAL_CAP_2,
        P_PAIRWISE_LEVEL_2_NEW
    }
    controllable = {ControllableActions}
}

controller ||NewController = (NEW_ENV)~{NEW_REQ}.
||NewCon = (NewController || NEW_ENV).

// =============================================================================
// Updating-controller targets: no transition requirements
// =============================================================================

// Traditional DUCS
updatingController UpdCont = {
    oldController = OldCon,
    oldEnvironment = {NODE_OLD(1), NODE_OLD(2)},
    newEnvironment = {NODE_NEW(1), NODE_NEW(2)},
    mapRelation = {R_NODE_1, R_NODE_2},
    oldGoal = OLD_REQ,
    newGoal = NEW_REQ,
    nonblocking
}

||COMPUTE_CLUSTER_STRONG_THERMAL_DERATING_TRADITIONAL = UpdCont.

// Stepwise DUCS: non-incremental stepwise_delayed + SBP
updatingController Stepwise_UpdCont = {
    oldController = OldCon,
    oldEnvironment = {NODE_OLD(1), NODE_OLD(2)},
    newEnvironment = {NODE_NEW(1), NODE_NEW(2)},
    mapRelation = {R_NODE_1, R_NODE_2},
    oldGoal = OLD_REQ,
    newGoal = NEW_REQ,
    nonblocking,
    stepwise_delayed,
    safetyBackwardPruning
}

||COMPUTE_CLUSTER_STRONG_THERMAL_DERATING_STEPWISE = Stepwise_UpdCont.
