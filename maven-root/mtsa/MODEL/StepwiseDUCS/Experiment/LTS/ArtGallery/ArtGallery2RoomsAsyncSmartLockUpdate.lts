//******************************************************************************
//* ArtGallery2RoomsAsyncSmartLockUpdate.lts
//*
//* Conversion source:
//*   MODEL/*ExperimentModels/ArtGallery（N, 2 room）.lts
//*
//* Environment-and-requirement update scenario:
//*   The two instantaneous electromechanical locks are replaced by networked
//*   smart locks.  A controllable command and the corresponding uncontrollable
//*   physical-completion acknowledgement are separate events.  The update is
//*   permitted only while visitor/count protocols and both old locks are in
//*   stable states.  Old unlocked/locked states map to the corresponding stable
//*   states of the new smart locks; no old state maps to an in-flight state.
//******************************************************************************

const N = 4
const TH_HALL = 2
const TH_A = 2

set DecisionAction = {
	allow_Hall,deny_Hall,
	allow_A,deny_A,
	allow_Out,deny_Out
}
set MonitorAction = {notEnter,arrive_Hall[1..N],arrive_A[1..N],leave}

set OldHallLockAction = {lock_Hall,unLock_Hall}
set OldRoomALockAction = {lock_A,unLock_A}
set OldControllableActions = {
	DecisionAction,resRoomStatus,
	OldHallLockAction,OldRoomALockAction
}

set NewHallLockCommand = {cmdLock_Hall,cmdUnlock_Hall}
set NewRoomALockCommand = {cmdLock_A,cmdUnlock_A}
set NewControllableActions = {
	DecisionAction,resRoomStatus,
	NewHallLockCommand,NewRoomALockCommand
}

// lockedAck_* and unlockedAck_* are intentionally absent from the
// controllable set: physical completion is controlled by the environment.

//******************************************************************************
//* Old environment: cleaned source-model behavior
//******************************************************************************

VISITOR_OLD =
(
	reqEnter_Hall -> VISITOR_OLD_WAIT_HALL_STATUS
	|reqEnter_A   -> VISITOR_OLD_WAIT_A_STATUS
	|reqOut       -> VISITOR_OLD_WAIT_OUT_STATUS
),
VISITOR_OLD_WAIT_HALL_STATUS = (resRoomStatus -> VISITOR_OLD_CHECK_HALL),
VISITOR_OLD_CHECK_HALL =
(
	allow_Hall -> VISITOR_OLD_WAIT_HALL_ARRIVAL
	|deny_Hall -> VISITOR_OLD_WAIT_NOT_ENTER
),
VISITOR_OLD_WAIT_HALL_ARRIVAL = (arrive_Hall[1..N] -> VISITOR_OLD),
VISITOR_OLD_WAIT_NOT_ENTER = (notEnter -> VISITOR_OLD),
VISITOR_OLD_WAIT_A_STATUS = (resRoomStatus -> VISITOR_OLD_CHECK_A),
VISITOR_OLD_CHECK_A =
(
	allow_A -> VISITOR_OLD_WAIT_A_ARRIVAL
	|deny_A -> VISITOR_OLD_WAIT_HALL_RETURN
),
VISITOR_OLD_WAIT_A_ARRIVAL = (arrive_A[1..N] -> VISITOR_OLD),
VISITOR_OLD_WAIT_HALL_RETURN = (arrive_Hall[1..N] -> VISITOR_OLD),
VISITOR_OLD_WAIT_OUT_STATUS = (resRoomStatus -> VISITOR_OLD_CHECK_OUT),
VISITOR_OLD_CHECK_OUT =
(
	allow_Out -> VISITOR_OLD_WAIT_LEAVE
	|deny_Out -> VISITOR_OLD_WAIT_A_RETURN
),
VISITOR_OLD_WAIT_LEAVE = (leave -> VISITOR_OLD),
VISITOR_OLD_WAIT_A_RETURN = (arrive_A[1..N] -> VISITOR_OLD).

HALL_OLD = HALL_OLD_COUNT[0],
HALL_OLD_COUNT[n:0..N] =
(
	when(n!=N) allow_Hall -> HALL_OLD_WAIT_ALLOW[n+1]
	|when(n!=N) deny_A -> HALL_OLD_WAIT_DENY_A[n+1]
	|when(n!=0) reqEnter_A -> HALL_OLD_COUNT[n-1]
),
HALL_OLD_WAIT_ALLOW[n:1..N] = (arrive_Hall[n] -> HALL_OLD_COUNT[n]),
HALL_OLD_WAIT_DENY_A[n:1..N] = (arrive_Hall[n] -> HALL_OLD_COUNT[n]).

ROOM_A_OLD = ROOM_A_OLD_COUNT[0],
ROOM_A_OLD_COUNT[n:0..N] =
(
	when(n!=N) allow_A -> ROOM_A_OLD_WAIT_ALLOW[n+1]
	|when(n!=N) deny_Out -> ROOM_A_OLD_WAIT_DENY_OUT[n+1]
	|when(n!=0) reqOut -> ROOM_A_OLD_COUNT[n-1]
),
ROOM_A_OLD_WAIT_ALLOW[n:1..N] = (arrive_A[n] -> ROOM_A_OLD_COUNT[n]),
ROOM_A_OLD_WAIT_DENY_OUT[n:1..N] = (arrive_A[n] -> ROOM_A_OLD_COUNT[n]).

DOOR_LOCK_HALL_OLD = (lock_Hall -> HALL_DOOR_LOCKED_OLD),
HALL_DOOR_LOCKED_OLD = (unLock_Hall -> DOOR_LOCK_HALL_OLD).

DOOR_LOCK_A_OLD = (lock_A -> A_DOOR_LOCKED_OLD),
A_DOOR_LOCKED_OLD = (unLock_A -> DOOR_LOCK_A_OLD).

||OLD_ENV =
(
	VISITOR_OLD
	|| HALL_OLD
	|| ROOM_A_OLD
	|| DOOR_LOCK_HALL_OLD
	|| DOOR_LOCK_A_OLD
).

//******************************************************************************
//* New environment: asynchronous smart locks
//******************************************************************************

// Visitor and occupancy-count behavior is unchanged by this update.
VISITOR_NEW =
(
	reqEnter_Hall -> VISITOR_NEW_WAIT_HALL_STATUS
	|reqEnter_A   -> VISITOR_NEW_WAIT_A_STATUS
	|reqOut       -> VISITOR_NEW_WAIT_OUT_STATUS
),
VISITOR_NEW_WAIT_HALL_STATUS = (resRoomStatus -> VISITOR_NEW_CHECK_HALL),
VISITOR_NEW_CHECK_HALL =
(
	allow_Hall -> VISITOR_NEW_WAIT_HALL_ARRIVAL
	|deny_Hall -> VISITOR_NEW_WAIT_NOT_ENTER
),
VISITOR_NEW_WAIT_HALL_ARRIVAL = (arrive_Hall[1..N] -> VISITOR_NEW),
VISITOR_NEW_WAIT_NOT_ENTER = (notEnter -> VISITOR_NEW),
VISITOR_NEW_WAIT_A_STATUS = (resRoomStatus -> VISITOR_NEW_CHECK_A),
VISITOR_NEW_CHECK_A =
(
	allow_A -> VISITOR_NEW_WAIT_A_ARRIVAL
	|deny_A -> VISITOR_NEW_WAIT_HALL_RETURN
),
VISITOR_NEW_WAIT_A_ARRIVAL = (arrive_A[1..N] -> VISITOR_NEW),
VISITOR_NEW_WAIT_HALL_RETURN = (arrive_Hall[1..N] -> VISITOR_NEW),
VISITOR_NEW_WAIT_OUT_STATUS = (resRoomStatus -> VISITOR_NEW_CHECK_OUT),
VISITOR_NEW_CHECK_OUT =
(
	allow_Out -> VISITOR_NEW_WAIT_LEAVE
	|deny_Out -> VISITOR_NEW_WAIT_A_RETURN
),
VISITOR_NEW_WAIT_LEAVE = (leave -> VISITOR_NEW),
VISITOR_NEW_WAIT_A_RETURN = (arrive_A[1..N] -> VISITOR_NEW).

HALL_NEW = HALL_NEW_COUNT[0],
HALL_NEW_COUNT[n:0..N] =
(
	when(n!=N) allow_Hall -> HALL_NEW_WAIT_ALLOW[n+1]
	|when(n!=N) deny_A -> HALL_NEW_WAIT_DENY_A[n+1]
	|when(n!=0) reqEnter_A -> HALL_NEW_COUNT[n-1]
),
HALL_NEW_WAIT_ALLOW[n:1..N] = (arrive_Hall[n] -> HALL_NEW_COUNT[n]),
HALL_NEW_WAIT_DENY_A[n:1..N] = (arrive_Hall[n] -> HALL_NEW_COUNT[n]).

ROOM_A_NEW = ROOM_A_NEW_COUNT[0],
ROOM_A_NEW_COUNT[n:0..N] =
(
	when(n!=N) allow_A -> ROOM_A_NEW_WAIT_ALLOW[n+1]
	|when(n!=N) deny_Out -> ROOM_A_NEW_WAIT_DENY_OUT[n+1]
	|when(n!=0) reqOut -> ROOM_A_NEW_COUNT[n-1]
),
ROOM_A_NEW_WAIT_ALLOW[n:1..N] = (arrive_A[n] -> ROOM_A_NEW_COUNT[n]),
ROOM_A_NEW_WAIT_DENY_OUT[n:1..N] = (arrive_A[n] -> ROOM_A_NEW_COUNT[n]).

// The opposite command is present in each in-flight state.  The new local
// safety requirements below force the controller to reject that conflict.
DOOR_LOCK_HALL_NEW = (cmdLock_Hall -> HALL_DOOR_LOCKING_NEW),
HALL_DOOR_LOCKING_NEW =
(
	lockedAck_Hall -> HALL_DOOR_LOCKED_NEW
	|cmdUnlock_Hall -> HALL_DOOR_UNLOCKING_NEW
),
HALL_DOOR_LOCKED_NEW = (cmdUnlock_Hall -> HALL_DOOR_UNLOCKING_NEW),
HALL_DOOR_UNLOCKING_NEW =
(
	unlockedAck_Hall -> DOOR_LOCK_HALL_NEW
	|cmdLock_Hall -> HALL_DOOR_LOCKING_NEW
).

DOOR_LOCK_A_NEW = (cmdLock_A -> A_DOOR_LOCKING_NEW),
A_DOOR_LOCKING_NEW =
(
	lockedAck_A -> A_DOOR_LOCKED_NEW
	|cmdUnlock_A -> A_DOOR_UNLOCKING_NEW
),
A_DOOR_LOCKED_NEW = (cmdUnlock_A -> A_DOOR_UNLOCKING_NEW),
A_DOOR_UNLOCKING_NEW =
(
	unlockedAck_A -> DOOR_LOCK_A_NEW
	|cmdLock_A -> A_DOOR_LOCKING_NEW
).

||NEW_ENV =
(
	VISITOR_NEW
	|| HALL_NEW
	|| ROOM_A_NEW
	|| DOOR_LOCK_HALL_NEW
	|| DOOR_LOCK_A_NEW
).

//******************************************************************************
//* Stable-state mappings
//******************************************************************************

relation R_VISITOR = {
	VISITOR_OLD@VISITOR_OLD = reconfigure -> VISITOR_NEW@VISITOR_NEW
}

relation R_HALL = {
	forall [n:0..N]
		HALL_OLD_COUNT[n]@HALL_OLD = reconfigure -> HALL_NEW_COUNT[n]@HALL_NEW
}

relation R_ROOM_A = {
	forall [n:0..N]
		ROOM_A_OLD_COUNT[n]@ROOM_A_OLD = reconfigure -> ROOM_A_NEW_COUNT[n]@ROOM_A_NEW
}

relation R_HALL_DOOR = {
	DOOR_LOCK_HALL_OLD@DOOR_LOCK_HALL_OLD = reconfigure -> DOOR_LOCK_HALL_NEW@DOOR_LOCK_HALL_NEW,
	HALL_DOOR_LOCKED_OLD@DOOR_LOCK_HALL_OLD = reconfigure -> HALL_DOOR_LOCKED_NEW@DOOR_LOCK_HALL_NEW
}

relation R_A_DOOR = {
	DOOR_LOCK_A_OLD@DOOR_LOCK_A_OLD = reconfigure -> DOOR_LOCK_A_NEW@DOOR_LOCK_A_NEW,
	A_DOOR_LOCKED_OLD@DOOR_LOCK_A_OLD = reconfigure -> A_DOOR_LOCKED_NEW@DOOR_LOCK_A_NEW
}

//******************************************************************************
//* Lock-state fluents
//******************************************************************************

set HallLockEstablished = {lock_Hall,lockedAck_Hall}
set HallUnlockEstablished = {unLock_Hall,unlockedAck_Hall}
set RoomALockEstablished = {lock_A,lockedAck_A}
set RoomAUnlockEstablished = {unLock_A,unlockedAck_A}

// Pure old/new fluents are used for standalone controller synthesis so that
// actions absent from that environment do not enlarge its alphabet.
fluent OLD_HALL_LOCKED = <lock_Hall,unLock_Hall>
fluent OLD_A_LOCKED = <lock_A,unLock_A>
fluent NEW_HALL_LOCKED = <lockedAck_Hall,unlockedAck_Hall>
fluent NEW_A_LOCKED = <lockedAck_A,unlockedAck_A>

// Update-only fluents preserve the physical lock valuation across reconfigure:
// an old lock event can establish the fluent and a new acknowledgement can
// subsequently terminate it (and vice versa).
fluent UPDATE_HALL_LOCKED = <HallLockEstablished,HallUnlockEstablished>
fluent UPDATE_A_LOCKED = <RoomALockEstablished,RoomAUnlockEstablished>
fluent UNLOCK_TIME = <MonitorAction,resRoomStatus>

//******************************************************************************
//* Old requirements
//******************************************************************************

fluent OLD_HALL_TH_LOCKED1 = <arrive_Hall[TH_HALL],allow_A>
fluent OLD_HALL_TH_LOCKED2 = <lock_Hall,allow_A>
fluent OLD_HALL_LOCK_TIME = <arrive_Hall[TH_HALL],resRoomStatus>
fluent OLD_HALL_LOCK_PENDING = <arrive_Hall[TH_HALL],{lock_Hall,unLock_Hall}>
fluent OLD_HALL_UNLOCK_PENDING = <allow_A,{lock_Hall,unLock_Hall}>

fluent OLD_A_TH_LOCKED1 = <arrive_A[TH_A],allow_Out>
fluent OLD_A_TH_LOCKED2 = <lock_A,allow_Out>
fluent OLD_A_LOCK_TIME = <arrive_A[TH_A],resRoomStatus>
fluent OLD_A_LOCK_PENDING = <arrive_A[TH_A],{lock_A,unLock_A}>
fluent OLD_A_UNLOCK_PENDING = <allow_Out,{lock_A,unLock_A}>

assert OLD_VISITOR_RULE_HALL = (OLD_HALL_LOCKED -> !allow_Hall)
assert OLD_LOCK_RULE_HALL1 = ((!OLD_HALL_LOCKED && OLD_HALL_LOCK_PENDING) -> !resRoomStatus)
assert OLD_LOCK_RULE_HALL2 = ((OLD_HALL_TH_LOCKED1 && OLD_HALL_TH_LOCKED2) -> !unLock_Hall)
assert OLD_UNLOCK_RULE_HALL1 = ((OLD_HALL_LOCKED && OLD_HALL_UNLOCK_PENDING) -> !resRoomStatus)
assert OLD_HALL_LOCK_TIMING = (!OLD_HALL_LOCK_TIME -> !lock_Hall)
assert OLD_HALL_UNLOCK_TIMING = (!UNLOCK_TIME -> !unLock_Hall)

assert OLD_VISITOR_RULE_A = (OLD_A_LOCKED -> !allow_A)
assert OLD_LOCK_RULE_A1 = ((!OLD_A_LOCKED && OLD_A_LOCK_PENDING) -> !resRoomStatus)
assert OLD_LOCK_RULE_A2 = ((OLD_A_TH_LOCKED1 && OLD_A_TH_LOCKED2) -> !unLock_A)
assert OLD_UNLOCK_RULE_A1 = ((OLD_A_LOCKED && OLD_A_UNLOCK_PENDING) -> !resRoomStatus)
assert OLD_A_LOCK_TIMING = (!OLD_A_LOCK_TIME -> !lock_A)
assert OLD_A_UNLOCK_TIMING = (!UNLOCK_TIME -> !unLock_A)

ltl_property P_OLD_VISITOR_RULE_HALL = []OLD_VISITOR_RULE_HALL
ltl_property P_OLD_LOCK_RULE_HALL1 = []OLD_LOCK_RULE_HALL1
ltl_property P_OLD_LOCK_RULE_HALL2 = []OLD_LOCK_RULE_HALL2
ltl_property P_OLD_UNLOCK_RULE_HALL1 = []OLD_UNLOCK_RULE_HALL1
ltl_property P_OLD_HALL_LOCK_TIMING = []OLD_HALL_LOCK_TIMING
ltl_property P_OLD_HALL_UNLOCK_TIMING = []OLD_HALL_UNLOCK_TIMING

ltl_property P_OLD_VISITOR_RULE_A = []OLD_VISITOR_RULE_A
ltl_property P_OLD_LOCK_RULE_A1 = []OLD_LOCK_RULE_A1
ltl_property P_OLD_LOCK_RULE_A2 = []OLD_LOCK_RULE_A2
ltl_property P_OLD_UNLOCK_RULE_A1 = []OLD_UNLOCK_RULE_A1
ltl_property P_OLD_A_LOCK_TIMING = []OLD_A_LOCK_TIMING
ltl_property P_OLD_A_UNLOCK_TIMING = []OLD_A_UNLOCK_TIMING

//******************************************************************************
//* New requirements: acknowledgements represent physical lock state
//******************************************************************************

fluent NEW_HALL_TH_LOCKED1 = <arrive_Hall[TH_HALL],allow_A>
fluent NEW_HALL_TH_LOCKED2 = <lockedAck_Hall,allow_A>
fluent NEW_HALL_LOCK_TIME = <arrive_Hall[TH_HALL],resRoomStatus>
fluent NEW_HALL_LOCK_PENDING = <arrive_Hall[TH_HALL],{lockedAck_Hall,unlockedAck_Hall}>
fluent NEW_HALL_UNLOCK_PENDING = <allow_A,{unlockedAck_Hall,lockedAck_Hall}>
fluent NEW_HALL_LOCK_COMMAND_PENDING = <cmdLock_Hall,{lockedAck_Hall,unlockedAck_Hall}>
fluent NEW_HALL_UNLOCK_COMMAND_PENDING = <cmdUnlock_Hall,{unlockedAck_Hall,lockedAck_Hall}>

fluent NEW_A_TH_LOCKED1 = <arrive_A[TH_A],allow_Out>
fluent NEW_A_TH_LOCKED2 = <lockedAck_A,allow_Out>
fluent NEW_A_LOCK_TIME = <arrive_A[TH_A],resRoomStatus>
fluent NEW_A_LOCK_PENDING = <arrive_A[TH_A],{lockedAck_A,unlockedAck_A}>
fluent NEW_A_UNLOCK_PENDING = <allow_Out,{unlockedAck_A,lockedAck_A}>
fluent NEW_A_LOCK_COMMAND_PENDING = <cmdLock_A,{lockedAck_A,unlockedAck_A}>
fluent NEW_A_UNLOCK_COMMAND_PENDING = <cmdUnlock_A,{unlockedAck_A,lockedAck_A}>

assert NEW_VISITOR_RULE_HALL = (NEW_HALL_LOCKED -> !allow_Hall)
assert NEW_LOCK_RULE_HALL1 = ((!NEW_HALL_LOCKED && NEW_HALL_LOCK_PENDING) -> !resRoomStatus)
assert NEW_LOCK_RULE_HALL2 = ((NEW_HALL_TH_LOCKED1 && NEW_HALL_TH_LOCKED2) -> !cmdUnlock_Hall)
assert NEW_UNLOCK_RULE_HALL1 = ((NEW_HALL_LOCKED && NEW_HALL_UNLOCK_PENDING) -> !resRoomStatus)
assert NEW_HALL_LOCK_TIMING = (!NEW_HALL_LOCK_TIME -> !cmdLock_Hall)
assert NEW_HALL_UNLOCK_TIMING = (!UNLOCK_TIME -> !cmdUnlock_Hall)
assert NEW_NO_CONFLICTING_HALL_COMMANDS =
	!(NEW_HALL_LOCK_COMMAND_PENDING && NEW_HALL_UNLOCK_COMMAND_PENDING)

assert NEW_VISITOR_RULE_A = (NEW_A_LOCKED -> !allow_A)
assert NEW_LOCK_RULE_A1 = ((!NEW_A_LOCKED && NEW_A_LOCK_PENDING) -> !resRoomStatus)
assert NEW_LOCK_RULE_A2 = ((NEW_A_TH_LOCKED1 && NEW_A_TH_LOCKED2) -> !cmdUnlock_A)
assert NEW_UNLOCK_RULE_A1 = ((NEW_A_LOCKED && NEW_A_UNLOCK_PENDING) -> !resRoomStatus)
assert NEW_A_LOCK_TIMING = (!NEW_A_LOCK_TIME -> !cmdLock_A)
assert NEW_A_UNLOCK_TIMING = (!UNLOCK_TIME -> !cmdUnlock_A)
assert NEW_NO_CONFLICTING_A_COMMANDS =
	!(NEW_A_LOCK_COMMAND_PENDING && NEW_A_UNLOCK_COMMAND_PENDING)

ltl_property P_NEW_VISITOR_RULE_HALL = []NEW_VISITOR_RULE_HALL
ltl_property P_NEW_LOCK_RULE_HALL1 = []NEW_LOCK_RULE_HALL1
ltl_property P_NEW_LOCK_RULE_HALL2 = []NEW_LOCK_RULE_HALL2
ltl_property P_NEW_UNLOCK_RULE_HALL1 = []NEW_UNLOCK_RULE_HALL1
ltl_property P_NEW_HALL_LOCK_TIMING = []NEW_HALL_LOCK_TIMING
ltl_property P_NEW_HALL_UNLOCK_TIMING = []NEW_HALL_UNLOCK_TIMING
ltl_property P_NEW_NO_CONFLICTING_HALL_COMMANDS = []NEW_NO_CONFLICTING_HALL_COMMANDS

ltl_property P_NEW_VISITOR_RULE_A = []NEW_VISITOR_RULE_A
ltl_property P_NEW_LOCK_RULE_A1 = []NEW_LOCK_RULE_A1
ltl_property P_NEW_LOCK_RULE_A2 = []NEW_LOCK_RULE_A2
ltl_property P_NEW_UNLOCK_RULE_A1 = []NEW_UNLOCK_RULE_A1
ltl_property P_NEW_A_LOCK_TIMING = []NEW_A_LOCK_TIMING
ltl_property P_NEW_A_UNLOCK_TIMING = []NEW_A_UNLOCK_TIMING
ltl_property P_NEW_NO_CONFLICTING_A_COMMANDS = []NEW_NO_CONFLICTING_A_COMMANDS

// Update synthesis must carry old physical state and pending-policy history
// into the new requirement monitor.  A pending fluent can therefore be
// terminated by either an old instantaneous lock action or a new physical ack.
fluent UPDATE_HALL_TH_LOCKED2 = <HallLockEstablished,allow_A>
fluent UPDATE_HALL_LOCK_PENDING =
	<arrive_Hall[TH_HALL],{lock_Hall,unLock_Hall,lockedAck_Hall,unlockedAck_Hall}>
fluent UPDATE_HALL_UNLOCK_PENDING =
	<allow_A,{lock_Hall,unLock_Hall,lockedAck_Hall,unlockedAck_Hall}>

fluent UPDATE_A_TH_LOCKED2 = <RoomALockEstablished,allow_Out>
fluent UPDATE_A_LOCK_PENDING =
	<arrive_A[TH_A],{lock_A,unLock_A,lockedAck_A,unlockedAck_A}>
fluent UPDATE_A_UNLOCK_PENDING =
	<allow_Out,{lock_A,unLock_A,lockedAck_A,unlockedAck_A}>

assert UPDATE_NEW_VISITOR_RULE_HALL = (UPDATE_HALL_LOCKED -> !allow_Hall)
assert UPDATE_NEW_LOCK_RULE_HALL1 =
	((!UPDATE_HALL_LOCKED && UPDATE_HALL_LOCK_PENDING) -> !resRoomStatus)
assert UPDATE_NEW_LOCK_RULE_HALL2 =
	((NEW_HALL_TH_LOCKED1 && UPDATE_HALL_TH_LOCKED2) -> !cmdUnlock_Hall)
assert UPDATE_NEW_UNLOCK_RULE_HALL1 =
	((UPDATE_HALL_LOCKED && UPDATE_HALL_UNLOCK_PENDING) -> !resRoomStatus)

assert UPDATE_NEW_VISITOR_RULE_A = (UPDATE_A_LOCKED -> !allow_A)
assert UPDATE_NEW_LOCK_RULE_A1 =
	((!UPDATE_A_LOCKED && UPDATE_A_LOCK_PENDING) -> !resRoomStatus)
assert UPDATE_NEW_LOCK_RULE_A2 =
	((NEW_A_TH_LOCKED1 && UPDATE_A_TH_LOCKED2) -> !cmdUnlock_A)
assert UPDATE_NEW_UNLOCK_RULE_A1 =
	((UPDATE_A_LOCKED && UPDATE_A_UNLOCK_PENDING) -> !resRoomStatus)

ltl_property P_UPDATE_NEW_VISITOR_RULE_HALL = []UPDATE_NEW_VISITOR_RULE_HALL
ltl_property P_UPDATE_NEW_LOCK_RULE_HALL1 = []UPDATE_NEW_LOCK_RULE_HALL1
ltl_property P_UPDATE_NEW_LOCK_RULE_HALL2 = []UPDATE_NEW_LOCK_RULE_HALL2
ltl_property P_UPDATE_NEW_UNLOCK_RULE_HALL1 = []UPDATE_NEW_UNLOCK_RULE_HALL1
ltl_property P_UPDATE_NEW_VISITOR_RULE_A = []UPDATE_NEW_VISITOR_RULE_A
ltl_property P_UPDATE_NEW_LOCK_RULE_A1 = []UPDATE_NEW_LOCK_RULE_A1
ltl_property P_UPDATE_NEW_LOCK_RULE_A2 = []UPDATE_NEW_LOCK_RULE_A2
ltl_property P_UPDATE_NEW_UNLOCK_RULE_A1 = []UPDATE_NEW_UNLOCK_RULE_A1

controllerSpec OLD_GALLERY_SPEC = {
	safety = {
		P_OLD_VISITOR_RULE_HALL,
		P_OLD_LOCK_RULE_HALL1,
		P_OLD_LOCK_RULE_HALL2,
		P_OLD_UNLOCK_RULE_HALL1,
		P_OLD_HALL_LOCK_TIMING,
		P_OLD_HALL_UNLOCK_TIMING,
		P_OLD_VISITOR_RULE_A,
		P_OLD_LOCK_RULE_A1,
		P_OLD_LOCK_RULE_A2,
		P_OLD_UNLOCK_RULE_A1,
		P_OLD_A_LOCK_TIMING,
		P_OLD_A_UNLOCK_TIMING
	}
	controllable = {OldControllableActions}
}

controllerSpec NEW_GALLERY_STANDALONE_SPEC = {
	safety = {
		P_NEW_VISITOR_RULE_HALL,
		P_NEW_LOCK_RULE_HALL1,
		P_NEW_LOCK_RULE_HALL2,
		P_NEW_UNLOCK_RULE_HALL1,
		P_NEW_HALL_LOCK_TIMING,
		P_NEW_HALL_UNLOCK_TIMING,
		P_NEW_NO_CONFLICTING_HALL_COMMANDS,
		P_NEW_VISITOR_RULE_A,
		P_NEW_LOCK_RULE_A1,
		P_NEW_LOCK_RULE_A2,
		P_NEW_UNLOCK_RULE_A1,
		P_NEW_A_LOCK_TIMING,
		P_NEW_A_UNLOCK_TIMING,
		P_NEW_NO_CONFLICTING_A_COMMANDS
	}
	controllable = {NewControllableActions}
}

controllerSpec NEW_GALLERY_UPDATE_SPEC = {
	safety = {
		P_UPDATE_NEW_VISITOR_RULE_HALL,
		P_UPDATE_NEW_LOCK_RULE_HALL1,
		P_UPDATE_NEW_LOCK_RULE_HALL2,
		P_UPDATE_NEW_UNLOCK_RULE_HALL1,
		P_NEW_HALL_LOCK_TIMING,
		P_NEW_HALL_UNLOCK_TIMING,
		P_NEW_NO_CONFLICTING_HALL_COMMANDS,
		P_UPDATE_NEW_VISITOR_RULE_A,
		P_UPDATE_NEW_LOCK_RULE_A1,
		P_UPDATE_NEW_LOCK_RULE_A2,
		P_UPDATE_NEW_UNLOCK_RULE_A1,
		P_NEW_A_LOCK_TIMING,
		P_NEW_A_UNLOCK_TIMING,
		P_NEW_NO_CONFLICTING_A_COMMANDS
	}
	controllable = {NewControllableActions}
}

controller ||OldController = (OLD_ENV)~{OLD_GALLERY_SPEC}.
||OldCon = (OldController || OLD_ENV).

controller ||NewController = (NEW_ENV)~{NEW_GALLERY_STANDALONE_SPEC}.
||NewCon = (NewController || NEW_ENV).

//******************************************************************************
//* Transition requirements
//******************************************************************************

fluent StopOldSpec = <stopOldSpec,hotSwapIn>
fluent StartNewSpec = <startNewSpec,hotSwapIn>
fluent Reconfigured = <reconfigure,hotSwapIn>

// T1 is written once per mapping component.  Door formulas contain the union
// of old instantaneous actions and new smart-lock commands.  Acknowledgements
// are uncontrollable and are therefore intentionally not prohibited.
assert NO_CONTROLLABLE_DURING_GAP_VISITOR =
	((StopOldSpec && !StartNewSpec) ->
	 !(resRoomStatus || allow_Hall || deny_Hall || allow_A || deny_A || allow_Out || deny_Out))
assert NO_CONTROLLABLE_DURING_GAP_HALL =
	((StopOldSpec && !StartNewSpec) -> !(allow_Hall || deny_A))
assert NO_CONTROLLABLE_DURING_GAP_ROOM_A =
	((StopOldSpec && !StartNewSpec) -> !(allow_A || deny_Out))
assert NO_CONTROLLABLE_DURING_GAP_HALL_DOOR =
	((StopOldSpec && !StartNewSpec) ->
	 !(lock_Hall || unLock_Hall || cmdLock_Hall || cmdUnlock_Hall))
assert NO_CONTROLLABLE_DURING_GAP_A_DOOR =
	((StopOldSpec && !StartNewSpec) ->
	 !(lock_A || unLock_A || cmdLock_A || cmdUnlock_A))

ltl_property T1_NO_CONTROLLABLE_DURING_GAP_VISITOR = []NO_CONTROLLABLE_DURING_GAP_VISITOR
ltl_property T1_NO_CONTROLLABLE_DURING_GAP_HALL = []NO_CONTROLLABLE_DURING_GAP_HALL
ltl_property T1_NO_CONTROLLABLE_DURING_GAP_ROOM_A = []NO_CONTROLLABLE_DURING_GAP_ROOM_A
ltl_property T1_NO_CONTROLLABLE_DURING_GAP_HALL_DOOR = []NO_CONTROLLABLE_DURING_GAP_HALL_DOOR
ltl_property T1_NO_CONTROLLABLE_DURING_GAP_A_DOOR = []NO_CONTROLLABLE_DURING_GAP_A_DOOR

// T2: startNewSpec is allowed only after both prerequisite events have
// occurred since the current hotSwapIn.
ltl_property T2_START_AFTER_STOP_AND_RECONFIGURE =
	[](startNewSpec -> (StopOldSpec && Reconfigured))

//******************************************************************************
//* Traditional and Stepwise DUCS use exactly the same update inputs
//******************************************************************************

// no_tr
updatingController UpdCont = {
	oldController = OldCon,
	oldEnvironment = {
		VISITOR_OLD,
		HALL_OLD,
		ROOM_A_OLD,
		DOOR_LOCK_HALL_OLD,
		DOOR_LOCK_A_OLD
	},
	newEnvironment = {
		VISITOR_NEW,
		HALL_NEW,
		ROOM_A_NEW,
		DOOR_LOCK_HALL_NEW,
		DOOR_LOCK_A_NEW
	},
	mapRelation = {R_VISITOR,R_HALL,R_ROOM_A,R_HALL_DOOR,R_A_DOOR},
	oldGoal = OLD_GALLERY_SPEC,
	newGoal = NEW_GALLERY_UPDATE_SPEC,
	nonblocking
}

||UPDATE_CONTROLLER = UpdCont.

updatingController Stepwise_UpdCont = {
	oldController = OldCon,
	oldEnvironment = {
		VISITOR_OLD,
		HALL_OLD,
		ROOM_A_OLD,
		DOOR_LOCK_HALL_OLD,
		DOOR_LOCK_A_OLD
	},
	newEnvironment = {
		VISITOR_NEW,
		HALL_NEW,
		ROOM_A_NEW,
		DOOR_LOCK_HALL_NEW,
		DOOR_LOCK_A_NEW
	},
	mapRelation = {R_VISITOR,R_HALL,R_ROOM_A,R_HALL_DOOR,R_A_DOOR},
	oldGoal = OLD_GALLERY_SPEC,
	newGoal = NEW_GALLERY_UPDATE_SPEC,
	nonblocking,
	stepwise_delayed,
	safetyBackwardPruning
}

||STEPWISE_UPDATE_CONTROLLER = Stepwise_UpdCont.

// T1
updatingController UpdCont_T1 = {
	oldController = OldCon,
	oldEnvironment = {
		VISITOR_OLD,
		HALL_OLD,
		ROOM_A_OLD,
		DOOR_LOCK_HALL_OLD,
		DOOR_LOCK_A_OLD
	},
	newEnvironment = {
		VISITOR_NEW,
		HALL_NEW,
		ROOM_A_NEW,
		DOOR_LOCK_HALL_NEW,
		DOOR_LOCK_A_NEW
	},
	mapRelation = {R_VISITOR,R_HALL,R_ROOM_A,R_HALL_DOOR,R_A_DOOR},
	oldGoal = OLD_GALLERY_SPEC,
	newGoal = NEW_GALLERY_UPDATE_SPEC,
	transition = T1_NO_CONTROLLABLE_DURING_GAP_VISITOR,
	transition = T1_NO_CONTROLLABLE_DURING_GAP_HALL,
	transition = T1_NO_CONTROLLABLE_DURING_GAP_ROOM_A,
	transition = T1_NO_CONTROLLABLE_DURING_GAP_HALL_DOOR,
	transition = T1_NO_CONTROLLABLE_DURING_GAP_A_DOOR,
	nonblocking
}

||UPDATE_CONTROLLER_T1 = UpdCont_T1.

updatingController Stepwise_UpdCont_T1 = {
	oldController = OldCon,
	oldEnvironment = {
		VISITOR_OLD,
		HALL_OLD,
		ROOM_A_OLD,
		DOOR_LOCK_HALL_OLD,
		DOOR_LOCK_A_OLD
	},
	newEnvironment = {
		VISITOR_NEW,
		HALL_NEW,
		ROOM_A_NEW,
		DOOR_LOCK_HALL_NEW,
		DOOR_LOCK_A_NEW
	},
	mapRelation = {R_VISITOR,R_HALL,R_ROOM_A,R_HALL_DOOR,R_A_DOOR},
	oldGoal = OLD_GALLERY_SPEC,
	newGoal = NEW_GALLERY_UPDATE_SPEC,
	transition = T1_NO_CONTROLLABLE_DURING_GAP_VISITOR,
	transition = T1_NO_CONTROLLABLE_DURING_GAP_HALL,
	transition = T1_NO_CONTROLLABLE_DURING_GAP_ROOM_A,
	transition = T1_NO_CONTROLLABLE_DURING_GAP_HALL_DOOR,
	transition = T1_NO_CONTROLLABLE_DURING_GAP_A_DOOR,
