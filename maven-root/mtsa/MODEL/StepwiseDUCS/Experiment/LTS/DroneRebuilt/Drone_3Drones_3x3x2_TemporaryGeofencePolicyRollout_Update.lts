    FLYING_OLD[1][3][2]@MOVE_OLD(1)
        = reconfigure -> FLYING_NEW[1][3][2]@MOVE_NEW(1),
    FLYING_OLD[2][1][1]@MOVE_OLD(1)
        = reconfigure -> FLYING_NEW[2][1][1]@MOVE_NEW(1),
    FLYING_OLD[2][1][2]@MOVE_OLD(1)
