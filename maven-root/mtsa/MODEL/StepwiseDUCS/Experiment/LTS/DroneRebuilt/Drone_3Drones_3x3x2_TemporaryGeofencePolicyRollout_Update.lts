// Drone Stepwise DUCS model: temporary-geofence policy rollout.
//
// Conversion source (left unchanged):
//   MODEL/StepwiseDUCS/Experiment/LTS/Drone_new/Drone(N, 2 drone).lts
//   SHA-256: dc6ed6c4c59badee8250b35bed62dd39c68b8b4cc1878621e1785860876f8834
//
// This file is a clean DUCS reconstruction and an explicitly scaled extension
// of the shared source.  It does not copy an existing Drone update model.
//
// Fixed scale:
// - 3 drones
// - x is 1..3, y is 1..3, and height is 1..2
// - 6 mapping components in this order:
//     BATTERY_1, MOVE_1, BATTERY_2, MOVE_2, BATTERY_3, MOVE_3
//
// Update meaning:
// - OLD and NEW environments have identical behavior.
// - The pre-update policy has no geofence requirement.  The source model's
//   asymmetric P_MOVE_LIMIT_1 and P_MOVE_LIMIT_2 are deliberately excluded.
// - The common goal preserves and scales the source low-battery and collision
//   policies to every drone and every reachable coordinate.
// - As separately approved, takeoff is also prohibited while the battery is
//   already low.
// - The NEW policy activates a temporary geofence at cell (1,1,2).
// - The geofence forbids the uncontrollable arrive[1][1][2] event.  Under
//   steady NEW operation, synthesis must disable its controllable predecessor
//   command (up, move[s], or move[w]).
//
// Policy boundary:
// - A pending arrive[1][1][2] cannot occur after startNewSpec.  If a command
//   toward that cell was issued under the OLD policy, the updating controller
//   must delay startNewSpec until that arrival has completed.
// - A drone already in (1,1,2) is not forcibly evacuated.
// - The policy means "no entry completion under the NEW policy", rather than
//   "the cell is empty immediately when the policy starts".
//
// Expected scopes:
// - each NEW geofence formula: the corresponding MOVE component only
// - each low-battery formula: BATTERY_i and MOVE_i
// - each collision formula: the two corresponding MOVE components
// - each T1 formula: one mapping component
// - T2: all 6 mapping components (update-event-only formula)
//
// MOVE states per drone: 86
// Collision formulas per OLD/NEW goal: 108
//
// The model defines Traditional and non-incremental Stepwise DUCS + SBP
// targets for no_tr, T1, and T2.

// =============================================================================
// Constants and action classification
// =============================================================================

const N = 3
const MaxX = 3
const MaxY = 3
const MaxH = 2

range DroneID = 1..N
range X = 1..MaxX
range Y = 1..MaxY
range H = 1..MaxH
range XYFrom2 = 2..3
range XYToBeforeMax = 1..2
range HFrom2 = 2..2
range HToBeforeMax = 1..1

set Drones = {drone[DroneID]}
set Direction = {n,s,e,w}

set ControllableActions = {
    [Drones].battery['safe],
    [Drones].takeoff,
    [Drones].land,
    [Drones].up,
    [Drones].down,
    [Drones].move[Direction]
}

// =============================================================================
// OLD environment: one battery and one movement component per drone
// =============================================================================

BATTERY_OLD(I=1) = BATTERY_SAFE_OLD,
BATTERY_SAFE_OLD = (
    drone[I].battery['low] -> BATTERY_LOW_OLD
),
BATTERY_LOW_OLD = (
    drone[I].battery['safe] -> BATTERY_SAFE_OLD
).

MOVE_OLD(I=1) = GROUNDED_OLD,
GROUNDED_OLD = (
    drone[I].takeoff -> WAIT_TAKEOFF_OLD
),
WAIT_TAKEOFF_OLD = (
    drone[I].arrive[1][1][1] -> FLYING_OLD[1][1][1]
),
FLYING_OLD[x:X][y:Y][h:H] = (
      when (x > 1)    drone[I].move['w] -> WAIT_W_OLD[x][y][h]
    | when (x < MaxX) drone[I].move['e] -> WAIT_E_OLD[x][y][h]
    | when (y > 1)    drone[I].move['s] -> WAIT_S_OLD[x][y][h]
    | when (y < MaxY) drone[I].move['n] -> WAIT_N_OLD[x][y][h]
    | when (h > 1)    drone[I].down -> WAIT_DOWN_OLD[x][y][h]
    | when (h < MaxH) drone[I].up -> WAIT_UP_OLD[x][y][h]
    | when (h == 1)   drone[I].land -> GROUNDED_OLD
),
WAIT_W_OLD[x:XYFrom2][y:Y][h:H] = (
    drone[I].arrive[x-1][y][h] -> FLYING_OLD[x-1][y][h]
),
WAIT_E_OLD[x:XYToBeforeMax][y:Y][h:H] = (
    drone[I].arrive[x+1][y][h] -> FLYING_OLD[x+1][y][h]
),
WAIT_S_OLD[x:X][y:XYFrom2][h:H] = (
    drone[I].arrive[x][y-1][h] -> FLYING_OLD[x][y-1][h]
),
WAIT_N_OLD[x:X][y:XYToBeforeMax][h:H] = (
    drone[I].arrive[x][y+1][h] -> FLYING_OLD[x][y+1][h]
),
WAIT_DOWN_OLD[x:X][y:Y][h:HFrom2] = (
    drone[I].arrive[x][y][h-1] -> FLYING_OLD[x][y][h-1]
),
WAIT_UP_OLD[x:X][y:Y][h:HToBeforeMax] = (
    drone[I].arrive[x][y][h+1] -> FLYING_OLD[x][y][h+1]
).

||OLD_ENV = (
    BATTERY_OLD(1) || MOVE_OLD(1) ||
    BATTERY_OLD(2) || MOVE_OLD(2) ||
    BATTERY_OLD(3) || MOVE_OLD(3)
).

// =============================================================================
// NEW environment: behaviorally identical to OLD
// =============================================================================

BATTERY_NEW(I=1) = BATTERY_SAFE_NEW,
BATTERY_SAFE_NEW = (
    drone[I].battery['low] -> BATTERY_LOW_NEW
),
BATTERY_LOW_NEW = (
    drone[I].battery['safe] -> BATTERY_SAFE_NEW
).

MOVE_NEW(I=1) = GROUNDED_NEW,
GROUNDED_NEW = (
    drone[I].takeoff -> WAIT_TAKEOFF_NEW
),
WAIT_TAKEOFF_NEW = (
    drone[I].arrive[1][1][1] -> FLYING_NEW[1][1][1]
),
FLYING_NEW[x:X][y:Y][h:H] = (
      when (x > 1)    drone[I].move['w] -> WAIT_W_NEW[x][y][h]
    | when (x < MaxX) drone[I].move['e] -> WAIT_E_NEW[x][y][h]
    | when (y > 1)    drone[I].move['s] -> WAIT_S_NEW[x][y][h]
    | when (y < MaxY) drone[I].move['n] -> WAIT_N_NEW[x][y][h]
    | when (h > 1)    drone[I].down -> WAIT_DOWN_NEW[x][y][h]
    | when (h < MaxH) drone[I].up -> WAIT_UP_NEW[x][y][h]
    | when (h == 1)   drone[I].land -> GROUNDED_NEW
),
WAIT_W_NEW[x:XYFrom2][y:Y][h:H] = (
    drone[I].arrive[x-1][y][h] -> FLYING_NEW[x-1][y][h]
),
WAIT_E_NEW[x:XYToBeforeMax][y:Y][h:H] = (
    drone[I].arrive[x+1][y][h] -> FLYING_NEW[x+1][y][h]
),
WAIT_S_NEW[x:X][y:XYFrom2][h:H] = (
    drone[I].arrive[x][y-1][h] -> FLYING_NEW[x][y-1][h]
),
WAIT_N_NEW[x:X][y:XYToBeforeMax][h:H] = (
    drone[I].arrive[x][y+1][h] -> FLYING_NEW[x][y+1][h]
),
WAIT_DOWN_NEW[x:X][y:Y][h:HFrom2] = (
    drone[I].arrive[x][y][h-1] -> FLYING_NEW[x][y][h-1]
),
WAIT_UP_NEW[x:X][y:Y][h:HToBeforeMax] = (
    drone[I].arrive[x][y][h+1] -> FLYING_NEW[x][y][h+1]
).

||NEW_ENV = (
    BATTERY_NEW(1) || MOVE_NEW(1) ||
    BATTERY_NEW(2) || MOVE_NEW(2) ||
    BATTERY_NEW(3) || MOVE_NEW(3)
).

// =============================================================================
// Total identity correspondence for all mapping components
// =============================================================================

relation R_BATTERY_1 = {
    BATTERY_SAFE_OLD@BATTERY_OLD(1)
        = reconfigure -> BATTERY_SAFE_NEW@BATTERY_NEW(1),
    BATTERY_LOW_OLD@BATTERY_OLD(1)
        = reconfigure -> BATTERY_LOW_NEW@BATTERY_NEW(1)
}

relation R_MOVE_1 = {
    GROUNDED_OLD@MOVE_OLD(1)
        = reconfigure -> GROUNDED_NEW@MOVE_NEW(1),
    WAIT_TAKEOFF_OLD@MOVE_OLD(1)
        = reconfigure -> WAIT_TAKEOFF_NEW@MOVE_NEW(1),

    FLYING_OLD[1][1][1]@MOVE_OLD(1)
        = reconfigure -> FLYING_NEW[1][1][1]@MOVE_NEW(1),
    FLYING_OLD[1][1][2]@MOVE_OLD(1)
        = reconfigure -> FLYING_NEW[1][1][2]@MOVE_NEW(1),
    FLYING_OLD[1][2][1]@MOVE_OLD(1)
