// NEW-only local geofence formulas.  arrive is uncontrollable, so synthesis
// must prevent or finish a pending entry before the NEW policy starts.
ltl_property P_NEW_GEOFENCE_1 =
    [](!drone[1].arrive[1][1][2])
ltl_property P_NEW_GEOFENCE_2 =
    [](!drone[2].arrive[1][1][2])

controllerSpec NEW_REQ = {
    safety = {
        P_NEW_NO_RECOVERY_WHILE_AIRBORNE_1,
