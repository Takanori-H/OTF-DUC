}

controller ||NewController = (NEW_ENV)~{NEW_REQ}.
||NewCon = (NewController || NEW_ENV).

// =============================================================================
// Transition requirements
// =============================================================================

fluent StopOldSpec = <stopOldSpec, hotSwapIn>
fluent StartNewSpec = <startNewSpec, hotSwapIn>
fluent Reconfigure = <reconfigure, hotSwapIn>

assert ANY_CONTROLLABLE_ACTION_BATTERY_1 = (
    drone[1].battery['safe]
)
assert NO_CONTROLLABLE_ACTION_DURING_GAP_BATTERY_1 =
    ((StopOldSpec && !StartNewSpec) ->
        !ANY_CONTROLLABLE_ACTION_BATTERY_1)
ltl_property T1_NO_CONTROLLABLE_DURING_GAP_BATTERY_1 =
    NO_CONTROLLABLE_ACTION_DURING_GAP_BATTERY_1

assert ANY_CONTROLLABLE_ACTION_MOVE_1 = (
    drone[1].takeoff ||
    drone[1].land ||
    drone[1].up ||
    drone[1].down ||
    drone[1].move['n] ||
    drone[1].move['s] ||
    drone[1].move['e] ||
    drone[1].move['w]
)
assert NO_CONTROLLABLE_ACTION_DURING_GAP_MOVE_1 =
    ((StopOldSpec && !StartNewSpec) ->
        !ANY_CONTROLLABLE_ACTION_MOVE_1)
ltl_property T1_NO_CONTROLLABLE_DURING_GAP_MOVE_1 =
    NO_CONTROLLABLE_ACTION_DURING_GAP_MOVE_1

assert ANY_CONTROLLABLE_ACTION_BATTERY_2 = (
    drone[2].battery['safe]
)
assert NO_CONTROLLABLE_ACTION_DURING_GAP_BATTERY_2 =
    ((StopOldSpec && !StartNewSpec) ->
        !ANY_CONTROLLABLE_ACTION_BATTERY_2)
ltl_property T1_NO_CONTROLLABLE_DURING_GAP_BATTERY_2 =
    NO_CONTROLLABLE_ACTION_DURING_GAP_BATTERY_2

assert ANY_CONTROLLABLE_ACTION_MOVE_2 = (
    drone[2].takeoff ||
    drone[2].land ||
    drone[2].up ||
    drone[2].down ||
    drone[2].move['n] ||
    drone[2].move['s] ||
    drone[2].move['e] ||
    drone[2].move['w]
)
assert NO_CONTROLLABLE_ACTION_DURING_GAP_MOVE_2 =
    ((StopOldSpec && !StartNewSpec) ->
        !ANY_CONTROLLABLE_ACTION_MOVE_2)
ltl_property T1_NO_CONTROLLABLE_DURING_GAP_MOVE_2 =
    NO_CONTROLLABLE_ACTION_DURING_GAP_MOVE_2

ltl_property T2_START_AFTER_STOP_AND_RECONFIGURE =
    (startNewSpec -> (StopOldSpec && Reconfigure))

// =============================================================================
// Updating-controller targets: no_tr, T1, and T2
// =============================================================================

updatingController UpdCont = {
    oldController = OldCon,
    oldEnvironment = {
        BATTERY_OLD(1), MOVE_OLD(1),
        BATTERY_OLD(2), MOVE_OLD(2)
    },
    newEnvironment = {
        BATTERY_NEW(1), MOVE_NEW(1),
        BATTERY_NEW(2), MOVE_NEW(2)
    },
    mapRelation = {
        R_BATTERY_1, R_MOVE_1,
        R_BATTERY_2, R_MOVE_2
    },
    oldGoal = OLD_REQ,
    newGoal = NEW_REQ,
    nonblocking
}

||DRONE_TEMPORARY_GEOFENCE_TRADITIONAL = UpdCont.

updatingController UpdCont_T1 = {
    oldController = OldCon,
    oldEnvironment = {
        BATTERY_OLD(1), MOVE_OLD(1),
        BATTERY_OLD(2), MOVE_OLD(2)
    },
    newEnvironment = {
        BATTERY_NEW(1), MOVE_NEW(1),
        BATTERY_NEW(2), MOVE_NEW(2)
    },
    mapRelation = {
        R_BATTERY_1, R_MOVE_1,
        R_BATTERY_2, R_MOVE_2
    },
    oldGoal = OLD_REQ,
    newGoal = NEW_REQ,
    transition = T1_NO_CONTROLLABLE_DURING_GAP_BATTERY_1,
