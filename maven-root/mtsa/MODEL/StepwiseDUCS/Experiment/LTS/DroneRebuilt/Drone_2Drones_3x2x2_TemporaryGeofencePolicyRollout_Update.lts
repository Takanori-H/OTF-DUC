    WAIT_UP_OLD[2][2][1]@MOVE_OLD(2)
        = reconfigure -> WAIT_UP_NEW[2][2][1]@MOVE_NEW(2),
    WAIT_UP_OLD[3][1][1]@MOVE_OLD(2)
        = reconfigure -> WAIT_UP_NEW[3][1][1]@MOVE_NEW(2),
    WAIT_UP_OLD[3][2][1]@MOVE_OLD(2)
        = reconfigure -> WAIT_UP_NEW[3][2][1]@MOVE_NEW(2)
}

// =============================================================================
// Common fluents
// =============================================================================

// True on the ground.  This preserves the shared source's actual
// P_LOW_BATTERY_LAND behavior: battery recovery is forbidden while airborne.
fluent GROUNDED[drone:Drones] =
    <[drone].land, [drone].takeoff> initially 1

fluent LOW_BATTERY[drone:Drones] =
    <[drone].battery['low], [drone].battery['safe]> initially 0

// Current occupied cell.  A movement command does not terminate the fluent;
// occupancy changes on the following arrive, as in the shared source.
fluent AT_H1[drone:Drones][x:X][y:Y] =
    <[drone].arrive[x][y][1],
     {[drone].arrive[X][Y][H], [drone].land}\{[drone].arrive[x][y][1]}>
    initially 0

fluent AT_H2[drone:Drones][x:X][y:Y] =
    <[drone].arrive[x][y][2],
     {[drone].arrive[X][Y][H], [drone].land}\{[drone].arrive[x][y][2]}>
    initially 0

// =============================================================================
// OLD common safety: source policies, excluding the old move-limit geofences
// =============================================================================

