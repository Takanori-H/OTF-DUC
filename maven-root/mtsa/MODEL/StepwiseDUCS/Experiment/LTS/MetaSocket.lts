set Controllable64 = {des64, output}
set Controllable128 = {des128, output}
set Alphabet64 = {Controllable64, input}
set Alphabet128 = {Controllable128, input}
set Alphabet = {des64, des128, output, input}

//ENVIRONMENTS
	DES64 = (des64 -> DES64).

	DES128 = (des128 -> DES128).

||ENV_DES64 = (DES64 || IO_OLD).
||ENV_DES128 = (DES128 || IO_NEW).

	IO_OLD = (input -> PROCESS),
	PROCESS = (output -> IO_OLD).
	
	IO_NEW = (input -> PROCESS),
	PROCESS = (output -> IO_NEW).

	relation R_IO = {IO_OLD@IO_OLD = reconfigure -> IO_NEW@IO_NEW,
					 PROCESS@IO_OLD = reconfigure -> PROCESS@IO_NEW}

	relation R_64_128 = {DES64@DES64 = reconfigure -> DES128@DES128}

	map MAPPING_IO = {IO_OLD, IO_NEW, R_IO}.

	map MAPPING_64_128 = {DES64, DES128, R_64_128}.

||MapEnv_64_128 = (MAPPING_IO || MAPPING_64_128).

// PROPERTIES
fluent InputRecieve = <input, output>
fluent EncriptionDone64 = <des64, input>
fluent EncriptionDone128 = <des128, input>

ltl_property P_DES64 = []((des64 -> InputRecieve) && (output -> EncriptionDone64))
ltl_property P_DES128 = []((des128 -> InputRecieve) && (output -> EncriptionDone128))

// CONTROLLERS
// 1
controllerSpec DES64_SPEC = {
	safety = {P_DES64}
	controllable = {Controllable64}
}

controller ||CONTROLLER64 = ENV_DES64~{DES64_SPEC}.
||CONTROLLER_ENVIRONMENT_64 = (CONTROLLER64||ENV_DES64).

// 2
controllerSpec DES128_SPEC = {
	safety = {P_DES128}
	controllable = {Controllable128}
}

controller ||CONTROLLER128 = ENV_DES128~{DES128_SPEC}.
||CONTROLLER_ENVIRONMENT_128 = (CONTROLLER128||ENV_DES128).

//------------------T--------------------
fluent StopOldSpec = <stopOldSpec, hotSwapIn>
fluent StartNewSpec = <startNewSpec, hotSwapIn>
fluent Reconfigure = <reconfigure, hotSwapIn>

assert NO_CONTROLLABLE_ACTION_DURING_GAP_IO =
	((StopOldSpec && !StartNewSpec) -> !output)
assert NO_CONTROLLABLE_ACTION_DURING_GAP_DES =
	((StopOldSpec && !StartNewSpec) -> !(des64 || des128))

ltl_property T1_NO_CONTROLLABLE_DURING_GAP_IO = NO_CONTROLLABLE_ACTION_DURING_GAP_IO
ltl_property T1_NO_CONTROLLABLE_DURING_GAP_DES = NO_CONTROLLABLE_ACTION_DURING_GAP_DES
ltl_property T2_START_AFTER_STOP_AND_RECONFIGURE =
	(startNewSpec -> (StopOldSpec && Reconfigure))

// Updates controllers

// 1
updatingController UpdCont = {
    oldController = CONTROLLER_ENVIRONMENT_64,
	oldEnvironment = {IO_OLD, DES64},
	newEnvironment = {IO_NEW, DES128},
	mapRelation = {R_IO, R_64_128},
	oldGoal = DES64_SPEC,
	newGoal = DES128_SPEC,
	nonblocking
}

||UPDATE_CONTROLLER = UpdCont.

updatingController UpdCont_T1 = {
    oldController = CONTROLLER_ENVIRONMENT_64,
	oldEnvironment = {IO_OLD, DES64},
	newEnvironment = {IO_NEW, DES128},
	mapRelation = {R_IO, R_64_128},
	oldGoal = DES64_SPEC,
	newGoal = DES128_SPEC,
    transition = T1_NO_CONTROLLABLE_DURING_GAP_IO,
    transition = T1_NO_CONTROLLABLE_DURING_GAP_DES,
	nonblocking
}

||UPDATE_CONTROLLER_T1 = UpdCont_T1.

updatingController UpdCont_T2 = {
    oldController = CONTROLLER_ENVIRONMENT_64,
	oldEnvironment = {IO_OLD, DES64},
	newEnvironment = {IO_NEW, DES128},
	mapRelation = {R_IO, R_64_128},
	oldGoal = DES64_SPEC,
	newGoal = DES128_SPEC,
    transition = T2_START_AFTER_STOP_AND_RECONFIGURE,
	nonblocking
}

||UPDATE_CONTROLLER_T2 = UpdCont_T2.

updatingController Stepwise_UpdCont = {
    oldController = CONTROLLER_ENVIRONMENT_64,
	oldEnvironment = {IO_OLD, DES64},
	newEnvironment = {IO_NEW, DES128},
	mapRelation = {R_IO, R_64_128},
	oldGoal = DES64_SPEC,
	newGoal = DES128_SPEC,
	nonblocking,
	stepwise_delayed,
	safetyBackwardPruning
}

||STEPWISE_UPDATE_CONTROLLER = Stepwise_UpdCont.

updatingController Stepwise_UpdCont_T1 = {
    oldController = CONTROLLER_ENVIRONMENT_64,
	oldEnvironment = {IO_OLD, DES64},
	newEnvironment = {IO_NEW, DES128},
	mapRelation = {R_IO, R_64_128},
	oldGoal = DES64_SPEC,
	newGoal = DES128_SPEC,
    transition = T1_NO_CONTROLLABLE_DURING_GAP_IO,
    transition = T1_NO_CONTROLLABLE_DURING_GAP_DES,
	nonblocking,
	stepwise_delayed,
	safetyBackwardPruning
}

||STEPWISE_UPDATE_CONTROLLER_T1 = Stepwise_UpdCont_T1.

updatingController Stepwise_UpdCont_T2 = {
    oldController = CONTROLLER_ENVIRONMENT_64,
	oldEnvironment = {IO_OLD, DES64},
	newEnvironment = {IO_NEW, DES128},
	mapRelation = {R_IO, R_64_128},
	oldGoal = DES64_SPEC,
	newGoal = DES128_SPEC,
    transition = T2_START_AFTER_STOP_AND_RECONFIGURE,
	nonblocking,
	stepwise_delayed,
	safetyBackwardPruning
}

||STEPWISE_UPDATE_CONTROLLER_T2 = Stepwise_UpdCont_T2.
