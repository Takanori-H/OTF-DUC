//******************************************************************************
//* ArtGallery2RoomsCoordinatedEntryUpdate.lts
//*
//* Two-room Dynamic Update Controller Synthesis scenario.
//*
//* Old policy:
//*   Hall and Room A enforce the twelve independent occupancy/lock rules.
//* New policy:
//*   The twelve rules remain, and Hall admission is disabled while Room A is
//*   locked.  This prevents a queue from growing in Hall while Room A is full.
//*
//* The physical environment is unchanged.  Every old environment state is
//* related to the corresponding new environment state by reconfigure.
//******************************************************************************

//******************************************************************************
//* Scale, thresholds, and action ownership
//******************************************************************************

const N = 4
const TH_HALL = 2
const TH_A = 2

set VisitorAction = {reqEnter_Hall,reqEnter_A,reqOut}

set HallLockAction = {lock_Hall,unLock_Hall}
set RoomALockAction = {lock_A,unLock_A}
set LockAction = {HallLockAction,RoomALockAction}

set DecisionAction = {
	allow_Hall,deny_Hall,
	allow_A,deny_A,
	allow_Out,deny_Out
}

// Preserved from the cleaned static baseline.  A sensor-response variant in
// which resRoomStatus is uncontrollable must be treated as a separate model.
set StatusAction = {resRoomStatus}

set DoorAction = {LockAction,DecisionAction,StatusAction}
set MonitorAction = {notEnter,arrive_Hall[1..N],arrive_A[1..N],leave}
set AllAction = {VisitorAction,DoorAction,MonitorAction}
set ControllableActions = {DoorAction}

//******************************************************************************
//* Old environment components
//******************************************************************************

// Every protocol phase is named so the identity relation can preserve an
// in-flight visitor request across reconfigure.
VISITOR_OLD =
(
	reqEnter_Hall -> OLD_WAIT_HALL_STATUS
	|reqEnter_A   -> OLD_WAIT_A_STATUS
	|reqOut       -> OLD_WAIT_OUT_STATUS
),
OLD_WAIT_HALL_STATUS = (resRoomStatus -> OLD_CHECK_HALL),
OLD_CHECK_HALL =
(
	allow_Hall -> OLD_WAIT_HALL_ARRIVAL
	|deny_Hall -> OLD_WAIT_NOT_ENTER
),
OLD_WAIT_HALL_ARRIVAL = (arrive_Hall[1..N] -> VISITOR_OLD),
OLD_WAIT_NOT_ENTER = (notEnter -> VISITOR_OLD),
OLD_WAIT_A_STATUS = (resRoomStatus -> OLD_CHECK_A),
OLD_CHECK_A =
(
	allow_A -> OLD_WAIT_A_ARRIVAL
	|deny_A -> OLD_WAIT_HALL_RETURN
),
OLD_WAIT_A_ARRIVAL = (arrive_A[1..N] -> VISITOR_OLD),
OLD_WAIT_HALL_RETURN = (arrive_Hall[1..N] -> VISITOR_OLD),
OLD_WAIT_OUT_STATUS = (resRoomStatus -> OLD_CHECK_OUT),
OLD_CHECK_OUT =
(
	allow_Out -> OLD_WAIT_LEAVE
	|deny_Out -> OLD_WAIT_A_RETURN
),
OLD_WAIT_LEAVE = (leave -> VISITOR_OLD),
OLD_WAIT_A_RETURN = (arrive_A[1..N] -> VISITOR_OLD).

HALL_OLD = HALL_COUNT_OLD[0],
HALL_COUNT_OLD[n:0..N] =
(
	when(n!=N) allow_Hall -> HALL_WAIT_ALLOW_OLD[n+1]
	|when(n!=N) deny_A -> HALL_WAIT_DENY_A_OLD[n+1]
	|when(n!=0) reqEnter_A -> HALL_COUNT_OLD[n-1]
),
HALL_WAIT_ALLOW_OLD[n:1..N] =
	(arrive_Hall[n] -> HALL_COUNT_OLD[n]),
HALL_WAIT_DENY_A_OLD[n:1..N] =
	(arrive_Hall[n] -> HALL_COUNT_OLD[n]).

ROOM_A_OLD = ROOM_A_COUNT_OLD[0],
ROOM_A_COUNT_OLD[n:0..N] =
(
	when(n!=N) allow_A -> ROOM_A_WAIT_ALLOW_OLD[n+1]
	|when(n!=N) deny_Out -> ROOM_A_WAIT_DENY_OUT_OLD[n+1]
	|when(n!=0) reqOut -> ROOM_A_COUNT_OLD[n-1]
),
ROOM_A_WAIT_ALLOW_OLD[n:1..N] =
	(arrive_A[n] -> ROOM_A_COUNT_OLD[n]),
ROOM_A_WAIT_DENY_OUT_OLD[n:1..N] =
	(arrive_A[n] -> ROOM_A_COUNT_OLD[n]).

DOOR_LOCK_HALL_OLD = (lock_Hall -> HALL_DOOR_LOCKED_OLD),
HALL_DOOR_LOCKED_OLD = (unLock_Hall -> DOOR_LOCK_HALL_OLD).

DOOR_LOCK_A_OLD = (lock_A -> A_DOOR_LOCKED_OLD),
A_DOOR_LOCKED_OLD = (unLock_A -> DOOR_LOCK_A_OLD).

||OLD_ENV =
(
	VISITOR_OLD
	|| HALL_OLD
	|| ROOM_A_OLD
	|| DOOR_LOCK_HALL_OLD
	|| DOOR_LOCK_A_OLD
).

//******************************************************************************
//* New environment components
//******************************************************************************

VISITOR_NEW =
(
	reqEnter_Hall -> NEW_WAIT_HALL_STATUS
	|reqEnter_A   -> NEW_WAIT_A_STATUS
	|reqOut       -> NEW_WAIT_OUT_STATUS
),
NEW_WAIT_HALL_STATUS = (resRoomStatus -> NEW_CHECK_HALL),
NEW_CHECK_HALL =
(
	allow_Hall -> NEW_WAIT_HALL_ARRIVAL
	|deny_Hall -> NEW_WAIT_NOT_ENTER
),
NEW_WAIT_HALL_ARRIVAL = (arrive_Hall[1..N] -> VISITOR_NEW),
NEW_WAIT_NOT_ENTER = (notEnter -> VISITOR_NEW),
NEW_WAIT_A_STATUS = (resRoomStatus -> NEW_CHECK_A),
NEW_CHECK_A =
(
	allow_A -> NEW_WAIT_A_ARRIVAL
	|deny_A -> NEW_WAIT_HALL_RETURN
),
NEW_WAIT_A_ARRIVAL = (arrive_A[1..N] -> VISITOR_NEW),
NEW_WAIT_HALL_RETURN = (arrive_Hall[1..N] -> VISITOR_NEW),
NEW_WAIT_OUT_STATUS = (resRoomStatus -> NEW_CHECK_OUT),
NEW_CHECK_OUT =
(
	allow_Out -> NEW_WAIT_LEAVE
	|deny_Out -> NEW_WAIT_A_RETURN
),
NEW_WAIT_LEAVE = (leave -> VISITOR_NEW),
NEW_WAIT_A_RETURN = (arrive_A[1..N] -> VISITOR_NEW).

HALL_NEW = HALL_COUNT_NEW[0],
HALL_COUNT_NEW[n:0..N] =
(
	when(n!=N) allow_Hall -> HALL_WAIT_ALLOW_NEW[n+1]
	|when(n!=N) deny_A -> HALL_WAIT_DENY_A_NEW[n+1]
	|when(n!=0) reqEnter_A -> HALL_COUNT_NEW[n-1]
),
HALL_WAIT_ALLOW_NEW[n:1..N] =
	(arrive_Hall[n] -> HALL_COUNT_NEW[n]),
HALL_WAIT_DENY_A_NEW[n:1..N] =
	(arrive_Hall[n] -> HALL_COUNT_NEW[n]).

ROOM_A_NEW = ROOM_A_COUNT_NEW[0],
ROOM_A_COUNT_NEW[n:0..N] =
(
	when(n!=N) allow_A -> ROOM_A_WAIT_ALLOW_NEW[n+1]
	|when(n!=N) deny_Out -> ROOM_A_WAIT_DENY_OUT_NEW[n+1]
	|when(n!=0) reqOut -> ROOM_A_COUNT_NEW[n-1]
),
ROOM_A_WAIT_ALLOW_NEW[n:1..N] =
	(arrive_A[n] -> ROOM_A_COUNT_NEW[n]),
ROOM_A_WAIT_DENY_OUT_NEW[n:1..N] =
	(arrive_A[n] -> ROOM_A_COUNT_NEW[n]).

DOOR_LOCK_HALL_NEW = (lock_Hall -> HALL_DOOR_LOCKED_NEW),
HALL_DOOR_LOCKED_NEW = (unLock_Hall -> DOOR_LOCK_HALL_NEW).

DOOR_LOCK_A_NEW = (lock_A -> A_DOOR_LOCKED_NEW),
A_DOOR_LOCKED_NEW = (unLock_A -> DOOR_LOCK_A_NEW).

||NEW_ENV =
(
	VISITOR_NEW
	|| HALL_NEW
	|| ROOM_A_NEW
	|| DOOR_LOCK_HALL_NEW
	|| DOOR_LOCK_A_NEW
).

//******************************************************************************
//* Identity mapping relations
//******************************************************************************

relation R_VISITOR_ID = {
	VISITOR_OLD@VISITOR_OLD = reconfigure -> VISITOR_NEW@VISITOR_NEW,
	OLD_WAIT_HALL_STATUS@VISITOR_OLD = reconfigure -> NEW_WAIT_HALL_STATUS@VISITOR_NEW,
	OLD_CHECK_HALL@VISITOR_OLD = reconfigure -> NEW_CHECK_HALL@VISITOR_NEW,
	OLD_WAIT_HALL_ARRIVAL@VISITOR_OLD = reconfigure -> NEW_WAIT_HALL_ARRIVAL@VISITOR_NEW,
	OLD_WAIT_NOT_ENTER@VISITOR_OLD = reconfigure -> NEW_WAIT_NOT_ENTER@VISITOR_NEW,
	OLD_WAIT_A_STATUS@VISITOR_OLD = reconfigure -> NEW_WAIT_A_STATUS@VISITOR_NEW,
	OLD_CHECK_A@VISITOR_OLD = reconfigure -> NEW_CHECK_A@VISITOR_NEW,
	OLD_WAIT_A_ARRIVAL@VISITOR_OLD = reconfigure -> NEW_WAIT_A_ARRIVAL@VISITOR_NEW,
	OLD_WAIT_HALL_RETURN@VISITOR_OLD = reconfigure -> NEW_WAIT_HALL_RETURN@VISITOR_NEW,
	OLD_WAIT_OUT_STATUS@VISITOR_OLD = reconfigure -> NEW_WAIT_OUT_STATUS@VISITOR_NEW,
	OLD_CHECK_OUT@VISITOR_OLD = reconfigure -> NEW_CHECK_OUT@VISITOR_NEW,
	OLD_WAIT_LEAVE@VISITOR_OLD = reconfigure -> NEW_WAIT_LEAVE@VISITOR_NEW,
	OLD_WAIT_A_RETURN@VISITOR_OLD = reconfigure -> NEW_WAIT_A_RETURN@VISITOR_NEW
}

relation R_HALL_ID = {
	forall[n:0..N]
		HALL_COUNT_OLD[n]@HALL_OLD = reconfigure -> HALL_COUNT_NEW[n]@HALL_NEW,
	forall[n:1..N]
		HALL_WAIT_ALLOW_OLD[n]@HALL_OLD = reconfigure -> HALL_WAIT_ALLOW_NEW[n]@HALL_NEW,
	forall[n:1..N]
		HALL_WAIT_DENY_A_OLD[n]@HALL_OLD = reconfigure -> HALL_WAIT_DENY_A_NEW[n]@HALL_NEW
}

relation R_ROOM_A_ID = {
	forall[n:0..N]
		ROOM_A_COUNT_OLD[n]@ROOM_A_OLD = reconfigure -> ROOM_A_COUNT_NEW[n]@ROOM_A_NEW,
	forall[n:1..N]
		ROOM_A_WAIT_ALLOW_OLD[n]@ROOM_A_OLD = reconfigure -> ROOM_A_WAIT_ALLOW_NEW[n]@ROOM_A_NEW,
	forall[n:1..N]
		ROOM_A_WAIT_DENY_OUT_OLD[n]@ROOM_A_OLD = reconfigure -> ROOM_A_WAIT_DENY_OUT_NEW[n]@ROOM_A_NEW
}

relation R_HALL_DOOR_ID = {
	DOOR_LOCK_HALL_OLD@DOOR_LOCK_HALL_OLD = reconfigure -> DOOR_LOCK_HALL_NEW@DOOR_LOCK_HALL_NEW,
	HALL_DOOR_LOCKED_OLD@DOOR_LOCK_HALL_OLD = reconfigure -> HALL_DOOR_LOCKED_NEW@DOOR_LOCK_HALL_NEW
}

relation R_A_DOOR_ID = {
	DOOR_LOCK_A_OLD@DOOR_LOCK_A_OLD = reconfigure -> DOOR_LOCK_A_NEW@DOOR_LOCK_A_NEW,
	A_DOOR_LOCKED_OLD@DOOR_LOCK_A_OLD = reconfigure -> A_DOOR_LOCKED_NEW@DOOR_LOCK_A_NEW
}

// Explicit map targets are useful for inspecting the mapping components without
// invoking update-controller synthesis.  The updatingController definitions
// below generate the same components from their three lists.
map MAP_VISITOR_ID = {VISITOR_OLD,VISITOR_NEW,R_VISITOR_ID}
map MAP_HALL_ID = {HALL_OLD,HALL_NEW,R_HALL_ID}
map MAP_ROOM_A_ID = {ROOM_A_OLD,ROOM_A_NEW,R_ROOM_A_ID}
map MAP_HALL_DOOR_ID = {DOOR_LOCK_HALL_OLD,DOOR_LOCK_HALL_NEW,R_HALL_DOOR_ID}
map MAP_A_DOOR_ID = {DOOR_LOCK_A_OLD,DOOR_LOCK_A_NEW,R_A_DOOR_ID}

||MAPPING_ENV =
(
	MAP_VISITOR_ID
	|| MAP_HALL_ID
	|| MAP_ROOM_A_ID
	|| MAP_HALL_DOOR_ID
	|| MAP_A_DOOR_ID
).

//******************************************************************************
//* Fluents shared by old and new requirements
//******************************************************************************

fluent HALL_LOCKED = <lock_Hall,unLock_Hall>
fluent HALL_TH_LOCKED1 = <arrive_Hall[TH_HALL],allow_A>
fluent HALL_TH_LOCKED2 = <lock_Hall,allow_A>
fluent HALL_LOCK_TIME = <arrive_Hall[TH_HALL],resRoomStatus>
fluent HALL_LOCK_PENDING =
	<arrive_Hall[TH_HALL],{lock_Hall,unLock_Hall}>
fluent HALL_UNLOCK_PENDING =
	<allow_A,{unLock_Hall,lock_Hall}>

fluent A_LOCKED = <lock_A,unLock_A>
fluent A_TH_LOCKED1 = <arrive_A[TH_A],allow_Out>
fluent A_TH_LOCKED2 = <lock_A,allow_Out>
fluent A_LOCK_TIME = <arrive_A[TH_A],resRoomStatus>
fluent A_LOCK_PENDING =
	<arrive_A[TH_A],{lock_A,unLock_A}>
fluent A_UNLOCK_PENDING =
	<allow_Out,{unLock_A,lock_A}>

// Intentionally shared by Hall and Room A.
fluent UNLOCK_TIME = <MonitorAction,resRoomStatus>

//******************************************************************************
//* The twelve common state-based safety requirements
//******************************************************************************

assert VISITOR_RULE_HALL = (HALL_LOCKED -> !allow_Hall)
assert LOCK_RULE_HALL1 =
	(((!HALL_LOCKED) && HALL_LOCK_PENDING) -> !resRoomStatus)
assert LOCK_RULE_HALL2 =
	((HALL_TH_LOCKED1 && HALL_TH_LOCKED2) -> !unLock_Hall)
assert UNLOCK_RULE_HALL1 =
	((HALL_LOCKED && HALL_UNLOCK_PENDING) -> !resRoomStatus)
assert HALL_LOCK_TIMING = (!HALL_LOCK_TIME -> !lock_Hall)
assert HALL_UNLOCK_TIMING = (!UNLOCK_TIME -> !unLock_Hall)

assert VISITOR_RULE_A = (A_LOCKED -> !allow_A)
assert LOCK_RULE_A1 =
	(((!A_LOCKED) && A_LOCK_PENDING) -> !resRoomStatus)
assert LOCK_RULE_A2 =
	((A_TH_LOCKED1 && A_TH_LOCKED2) -> !unLock_A)
assert UNLOCK_RULE_A1 =
	((A_LOCKED && A_UNLOCK_PENDING) -> !resRoomStatus)
assert A_LOCK_TIMING = (!A_LOCK_TIME -> !lock_A)
assert A_UNLOCK_TIMING = (!UNLOCK_TIME -> !unLock_A)

ltl_property P_VISITOR_RULE_HALL = []VISITOR_RULE_HALL
ltl_property P_LOCK_RULE_HALL1 = []LOCK_RULE_HALL1
ltl_property P_LOCK_RULE_HALL2 = []LOCK_RULE_HALL2
ltl_property P_UNLOCK_RULE_HALL1 = []UNLOCK_RULE_HALL1
ltl_property P_HALL_LOCK_TIMING = []HALL_LOCK_TIMING
ltl_property P_HALL_UNLOCK_TIMING = []HALL_UNLOCK_TIMING

ltl_property P_VISITOR_RULE_A = []VISITOR_RULE_A
ltl_property P_LOCK_RULE_A1 = []LOCK_RULE_A1
ltl_property P_LOCK_RULE_A2 = []LOCK_RULE_A2
ltl_property P_UNLOCK_RULE_A1 = []UNLOCK_RULE_A1
ltl_property P_A_LOCK_TIMING = []A_LOCK_TIMING
ltl_property P_A_UNLOCK_TIMING = []A_UNLOCK_TIMING

//******************************************************************************
//* New coordinated-entry requirement
//******************************************************************************

// If Room A is locked, a new visitor may not be admitted into Hall.  Movement
// from Hall to Room A remains allowed so that Hall can continue to drain.
assert COORDINATED_ENTRY = (A_LOCKED -> !allow_Hall)
ltl_property P_COORDINATED_ENTRY = []COORDINATED_ENTRY

//******************************************************************************
//* Old and new controller goals
//******************************************************************************

controllerSpec OLD_GALLERY_SPEC =
{
	safety = {
		P_VISITOR_RULE_HALL,
		P_LOCK_RULE_HALL1,
		P_LOCK_RULE_HALL2,
		P_UNLOCK_RULE_HALL1,
		P_HALL_LOCK_TIMING,
		P_HALL_UNLOCK_TIMING,
		P_VISITOR_RULE_A,
		P_LOCK_RULE_A1,
		P_LOCK_RULE_A2,
		P_UNLOCK_RULE_A1,
		P_A_LOCK_TIMING,
		P_A_UNLOCK_TIMING
	}
	controllable = {ControllableActions}
}

controllerSpec NEW_GALLERY_SPEC =
{
	safety = {
		P_VISITOR_RULE_HALL,
		P_LOCK_RULE_HALL1,
		P_LOCK_RULE_HALL2,
		P_UNLOCK_RULE_HALL1,
		P_HALL_LOCK_TIMING,
		P_HALL_UNLOCK_TIMING,
		P_VISITOR_RULE_A,
		P_LOCK_RULE_A1,
		P_LOCK_RULE_A2,
		P_UNLOCK_RULE_A1,
		P_A_LOCK_TIMING,
		P_A_UNLOCK_TIMING,
		P_COORDINATED_ENTRY
	}
	controllable = {ControllableActions}
}

controller ||OldController = (OLD_ENV)~{OLD_GALLERY_SPEC}.
||OldCon = (OldController || OLD_ENV).

controller ||NewController = (NEW_ENV)~{NEW_GALLERY_SPEC}.
||NewCon = (NewController || NEW_ENV).

//******************************************************************************
//* Transition requirements
//******************************************************************************

// DUCS is free to choose the order of stopOldSpec, reconfigure, and
// startNewSpec.  If it stops the old specification before starting the new
// one, neither goal protects the intervening gap.  Freeze only the gallery's
// controllable operational actions in that phase.  Update actions and all
// uncontrollable Visitor/Monitor actions remain available.
fluent UPDATE_OLD_STOPPED = <stopOldSpec,hotSwapIn>
fluent UPDATE_NEW_STARTED = <startNewSpec,hotSwapIn>

assert FREEZE_UNPROTECTED_GAP =
(
	(UPDATE_OLD_STOPPED && !UPDATE_NEW_STARTED)
	-> !(
		resRoomStatus
		|| lock_Hall || unLock_Hall
		|| lock_A || unLock_A
		|| allow_Hall || deny_Hall
		|| allow_A || deny_A
		|| allow_Out || deny_Out
	)
)

// Supplied without a leading [] to follow the existing Traditional/Stepwise
// DUCS transition-requirement convention.  The formula is state based.
ltl_property T_FREEZE_UNPROTECTED_GAP = FREEZE_UNPROTECTED_GAP

assert NO_CONTROLLABLE_ACTION_DURING_GAP_VISITOR =
	((UPDATE_OLD_STOPPED && !UPDATE_NEW_STARTED) ->
	 !(resRoomStatus
	   || allow_Hall || deny_Hall
	   || allow_A || deny_A
	   || allow_Out || deny_Out))
assert NO_CONTROLLABLE_ACTION_DURING_GAP_HALL =
	((UPDATE_OLD_STOPPED && !UPDATE_NEW_STARTED) -> !(allow_Hall || deny_A))
assert NO_CONTROLLABLE_ACTION_DURING_GAP_ROOM_A =
	((UPDATE_OLD_STOPPED && !UPDATE_NEW_STARTED) -> !(allow_A || deny_Out))
assert NO_CONTROLLABLE_ACTION_DURING_GAP_HALL_DOOR =
	((UPDATE_OLD_STOPPED && !UPDATE_NEW_STARTED) -> !(lock_Hall || unLock_Hall))
assert NO_CONTROLLABLE_ACTION_DURING_GAP_A_DOOR =
	((UPDATE_OLD_STOPPED && !UPDATE_NEW_STARTED) -> !(lock_A || unLock_A))

ltl_property T1_NO_CONTROLLABLE_DURING_GAP_VISITOR = NO_CONTROLLABLE_ACTION_DURING_GAP_VISITOR
ltl_property T1_NO_CONTROLLABLE_DURING_GAP_HALL = NO_CONTROLLABLE_ACTION_DURING_GAP_HALL
ltl_property T1_NO_CONTROLLABLE_DURING_GAP_ROOM_A = NO_CONTROLLABLE_ACTION_DURING_GAP_ROOM_A
ltl_property T1_NO_CONTROLLABLE_DURING_GAP_HALL_DOOR = NO_CONTROLLABLE_ACTION_DURING_GAP_HALL_DOOR
ltl_property T1_NO_CONTROLLABLE_DURING_GAP_A_DOOR = NO_CONTROLLABLE_ACTION_DURING_GAP_A_DOOR
ltl_property T2_RECONFIGURE_AFTER_STOP_AND_START =
	(reconfigure -> (UPDATE_OLD_STOPPED && UPDATE_NEW_STARTED))

//******************************************************************************
//* Updating-controller targets
//******************************************************************************

// This directly executable version uses the five atomic environment components
// as Stepwise stages.  Because visitor/count/door actions are shared, its safety
// goals are cross-heavy.  A paper-aligned grouped two-stage variant is a
// separate future benchmark, not an implicit interpretation of this file.

updatingController ArtGalleryUpdateTraditional = {
	oldController = OldCon,
	oldEnvironment = {
		VISITOR_OLD,
		HALL_OLD,
		ROOM_A_OLD,
		DOOR_LOCK_HALL_OLD,
		DOOR_LOCK_A_OLD
	},
	newEnvironment = {
		VISITOR_NEW,
		HALL_NEW,
		ROOM_A_NEW,
		DOOR_LOCK_HALL_NEW,
		DOOR_LOCK_A_NEW
	},
	mapRelation = {
		R_VISITOR_ID,
		R_HALL_ID,
		R_ROOM_A_ID,
		R_HALL_DOOR_ID,
		R_A_DOOR_ID
	},
	oldGoal = OLD_GALLERY_SPEC,
	newGoal = NEW_GALLERY_SPEC,
//	transition = T_FREEZE_UNPROTECTED_GAP,
	nonblocking
}

||UPDATE_CONTROLLER = ArtGalleryUpdateTraditional.

updatingController ArtGalleryUpdateTraditionalT1 = {
	oldController = OldCon,
	oldEnvironment = {
		VISITOR_OLD,
		HALL_OLD,
		ROOM_A_OLD,
		DOOR_LOCK_HALL_OLD,
		DOOR_LOCK_A_OLD
	},
	newEnvironment = {
		VISITOR_NEW,
		HALL_NEW,
		ROOM_A_NEW,
		DOOR_LOCK_HALL_NEW,
		DOOR_LOCK_A_NEW
	},
	mapRelation = {
		R_VISITOR_ID,
		R_HALL_ID,
		R_ROOM_A_ID,
		R_HALL_DOOR_ID,
		R_A_DOOR_ID
	},
	oldGoal = OLD_GALLERY_SPEC,
	newGoal = NEW_GALLERY_SPEC,
	transition = T1_NO_CONTROLLABLE_DURING_GAP_VISITOR,
	transition = T1_NO_CONTROLLABLE_DURING_GAP_HALL,
	transition = T1_NO_CONTROLLABLE_DURING_GAP_ROOM_A,
	transition = T1_NO_CONTROLLABLE_DURING_GAP_HALL_DOOR,
	transition = T1_NO_CONTROLLABLE_DURING_GAP_A_DOOR,
	nonblocking
}

||UPDATE_CONTROLLER_T1 = ArtGalleryUpdateTraditionalT1.

updatingController ArtGalleryUpdateTraditionalT2 = {
	oldController = OldCon,
	oldEnvironment = {
		VISITOR_OLD,
		HALL_OLD,
		ROOM_A_OLD,
		DOOR_LOCK_HALL_OLD,
		DOOR_LOCK_A_OLD
	},
	newEnvironment = {
		VISITOR_NEW,
		HALL_NEW,
		ROOM_A_NEW,
		DOOR_LOCK_HALL_NEW,
		DOOR_LOCK_A_NEW
	},
	mapRelation = {
		R_VISITOR_ID,
		R_HALL_ID,
		R_ROOM_A_ID,
		R_HALL_DOOR_ID,
		R_A_DOOR_ID
	},
	oldGoal = OLD_GALLERY_SPEC,
	newGoal = NEW_GALLERY_SPEC,
	transition = T2_RECONFIGURE_AFTER_STOP_AND_START,
	nonblocking
}

||UPDATE_CONTROLLER_T2 = ArtGalleryUpdateTraditionalT2.

updatingController ArtGalleryUpdateStepwiseDelayed = {
	oldController = OldCon,
	oldEnvironment = {
		VISITOR_OLD,
		HALL_OLD,
		ROOM_A_OLD,
		DOOR_LOCK_HALL_OLD,
		DOOR_LOCK_A_OLD
	},
	newEnvironment = {
		VISITOR_NEW,
		HALL_NEW,
		ROOM_A_NEW,
		DOOR_LOCK_HALL_NEW,
		DOOR_LOCK_A_NEW
	},
	mapRelation = {
		R_VISITOR_ID,
		R_HALL_ID,
		R_ROOM_A_ID,
		R_HALL_DOOR_ID,
		R_A_DOOR_ID
	},
	oldGoal = OLD_GALLERY_SPEC,
	newGoal = NEW_GALLERY_SPEC,
//	transition = T_FREEZE_UNPROTECTED_GAP,
	nonblocking,
	stepwise_delayed,
	safetyBackwardPruning
}

||STEPWISE_DELAYED_UPDATE_CONTROLLER = ArtGalleryUpdateStepwiseDelayed.

updatingController ArtGalleryUpdateStepwiseDelayedT1 = {
	oldController = OldCon,
	oldEnvironment = {
		VISITOR_OLD,
		HALL_OLD,
		ROOM_A_OLD,
		DOOR_LOCK_HALL_OLD,
		DOOR_LOCK_A_OLD
	},
	newEnvironment = {
		VISITOR_NEW,
		HALL_NEW,
		ROOM_A_NEW,
		DOOR_LOCK_HALL_NEW,
		DOOR_LOCK_A_NEW
	},
	mapRelation = {
		R_VISITOR_ID,
		R_HALL_ID,
