// Minimal three-stage DUCS example for scope-based staged cross pruning.
// Cross old safety intentionally refers only to stages 1 and 2.

set OldControllableActions_1 = {old_1}
set OldControllableActions_2 = {old_2}
set OldControllableActions_3 = {old_3}
set OldControllableActions = {old_1, old_2, old_3}

set NewControllableActions_1 = {new_1}
set NewControllableActions_2 = {new_2}
set NewControllableActions_3 = {new_3}
set NewControllableActions = {new_1, new_2, new_3}

// ---------------------------OLD ENVIRONMENTS-----------------------------
SIMPLE_OLD_1 = (old_1 -> OLD_BUSY_1),
	OLD_BUSY_1 = (oldDone_1 -> SIMPLE_OLD_1).

SIMPLE_OLD_2 = (old_2 -> OLD_BUSY_2),
	OLD_BUSY_2 = (oldDone_2 -> SIMPLE_OLD_2).

SIMPLE_OLD_3 = (old_3 -> OLD_BUSY_3),
	OLD_BUSY_3 = (oldDone_3 -> SIMPLE_OLD_3).

// ---------------------------NEW ENVIRONMENTS-----------------------------
SIMPLE_NEW_1 = (new_1 -> NEW_BUSY_1),
	NEW_BUSY_1 = (newDone_1 -> SIMPLE_NEW_1).

SIMPLE_NEW_2 = (new_2 -> NEW_BUSY_2),
	NEW_BUSY_2 = (newDone_2 -> SIMPLE_NEW_2).

SIMPLE_NEW_3 = (new_3 -> NEW_BUSY_3),
	NEW_BUSY_3 = (newDone_3 -> SIMPLE_NEW_3).

// ---------------------------MAP RELATIONS-----------------------------
relation R_SIMPLE_1 = {SIMPLE_OLD_1@SIMPLE_OLD_1	= reconfigure -> SIMPLE_NEW_1@SIMPLE_NEW_1,
					  OLD_BUSY_1@SIMPLE_OLD_1		= reconfigure -> SIMPLE_NEW_1@SIMPLE_NEW_1}

relation R_SIMPLE_2 = {SIMPLE_OLD_2@SIMPLE_OLD_2	= reconfigure -> SIMPLE_NEW_2@SIMPLE_NEW_2,
					  OLD_BUSY_2@SIMPLE_OLD_2		= reconfigure -> SIMPLE_NEW_2@SIMPLE_NEW_2}

relation R_SIMPLE_3 = {SIMPLE_OLD_3@SIMPLE_OLD_3	= reconfigure -> SIMPLE_NEW_3@SIMPLE_NEW_3,
					  OLD_BUSY_3@SIMPLE_OLD_3		= reconfigure -> SIMPLE_NEW_3@SIMPLE_NEW_3}

map MAP_SIMPLE_1 = {SIMPLE_OLD_1, SIMPLE_NEW_1, R_SIMPLE_1}
map MAP_SIMPLE_2 = {SIMPLE_OLD_2, SIMPLE_NEW_2, R_SIMPLE_2}
map MAP_SIMPLE_3 = {SIMPLE_OLD_3, SIMPLE_NEW_3, R_SIMPLE_3}

||OLD_ENV_1 = (SIMPLE_OLD_1).
||OLD_ENV_2 = (SIMPLE_OLD_2).
||OLD_ENV_3 = (SIMPLE_OLD_3).
||OLD_ENV = (SIMPLE_OLD_1 || SIMPLE_OLD_2 || SIMPLE_OLD_3).

||NEW_ENV_1 = (SIMPLE_NEW_1).
||NEW_ENV_2 = (SIMPLE_NEW_2).
||NEW_ENV_3 = (SIMPLE_NEW_3).
||NEW_ENV = (SIMPLE_NEW_1 || SIMPLE_NEW_2 || SIMPLE_NEW_3).

||MAPPING_ENV_1 = (MAP_SIMPLE_1).
||MAPPING_ENV_2 = (MAP_SIMPLE_2).
||MAPPING_ENV_3 = (MAP_SIMPLE_3).
||MAPPING_ENV = (MAP_SIMPLE_1 || MAP_SIMPLE_2 || MAP_SIMPLE_3).
||MapEnvironment = (MAP_SIMPLE_1 || MAP_SIMPLE_2 || MAP_SIMPLE_3).

// ---------------------------FLUENTS-----------------------------
fluent OldPending_1 = <old_1, oldDone_1>
fluent OldPending_2 = <old_2, oldDone_2>
fluent OldPending_3 = <old_3, oldDone_3>

fluent NewPending_1 = <new_1, newDone_1>
fluent NewPending_2 = <new_2, newDone_2>
fluent NewPending_3 = <new_3, newDone_3>

// ---------------------------OLD CONTROLLER SPEC-----------------------------
assert OLD_NO_SIMULTANEOUS_1_2 = !(OldPending_1 && OldPending_2)

ltl_property P_OLD_NO_SIMULTANEOUS_1_2 = []OLD_NO_SIMULTANEOUS_1_2

controllerSpec OLD_SIMPLE = {
	safety = {
			P_OLD_NO_SIMULTANEOUS_1_2
			}
	controllable = {OldControllableActions}
}
controller ||OldController = (OLD_ENV)~{OLD_SIMPLE}.
||OldCon = (OldController || OLD_ENV).

controllerSpec OLD_SIMPLE_1 = {
	safety = {}
	controllable = {OldControllableActions_1}
}
controller ||OldController_1 = (OLD_ENV_1)~{OLD_SIMPLE_1}.
||OldCon_1 = (OldController_1 || OLD_ENV_1).

controllerSpec OLD_SIMPLE_2 = {
	safety = {}
	controllable = {OldControllableActions_2}
}
controller ||OldController_2 = (OLD_ENV_2)~{OLD_SIMPLE_2}.
||OldCon_2 = (OldController_2 || OLD_ENV_2).

controllerSpec OLD_SIMPLE_3 = {
	safety = {}
	controllable = {OldControllableActions_3}
}
controller ||OldController_3 = (OLD_ENV_3)~{OLD_SIMPLE_3}.
||OldCon_3 = (OldController_3 || OLD_ENV_3).

// ---------------------------NEW CONTROLLER SPEC-----------------------------
controllerSpec NEW_SIMPLE = {
	safety = {}
	controllable = {NewControllableActions}
}
controller ||NewController = (NEW_ENV)~{NEW_SIMPLE}.
||NewCon = (NewController || NEW_ENV).

controllerSpec NEW_SIMPLE_1 = {
	safety = {}
	controllable = {NewControllableActions_1}
}
controller ||NewController_1 = (NEW_ENV_1)~{NEW_SIMPLE_1}.
||NewCon_1 = (NewController_1 || NEW_ENV_1).

controllerSpec NEW_SIMPLE_2 = {
	safety = {}
	controllable = {NewControllableActions_2}
}
controller ||NewController_2 = (NEW_ENV_2)~{NEW_SIMPLE_2}.
||NewCon_2 = (NewController_2 || NEW_ENV_2).

controllerSpec NEW_SIMPLE_3 = {
	safety = {}
	controllable = {NewControllableActions_3}
}
controller ||NewController_3 = (NEW_ENV_3)~{NEW_SIMPLE_3}.
||NewCon_3 = (NewController_3 || NEW_ENV_3).

// ---------------------------UPDATING CONTROLLER SPEC-----------------------------
updatingController UpdCont = {
    oldController = OldCon,
    oldEnvironment = {SIMPLE_OLD_1, SIMPLE_OLD_2, SIMPLE_OLD_3},
	newEnvironment = {SIMPLE_NEW_1, SIMPLE_NEW_2, SIMPLE_NEW_3},
	mapRelation = {R_SIMPLE_1, R_SIMPLE_2, R_SIMPLE_3},
    oldGoal = OLD_SIMPLE,
    newGoal = NEW_SIMPLE,
    nonblocking
}

||UPDATE_CONTROLLER = UpdCont.

updatingController UpdCont_stepwise = {
    oldController = OldCon,
    oldEnvironment = {SIMPLE_OLD_1, SIMPLE_OLD_2, SIMPLE_OLD_3},
	newEnvironment = {SIMPLE_NEW_1, SIMPLE_NEW_2, SIMPLE_NEW_3},
	mapRelation = {R_SIMPLE_1, R_SIMPLE_2, R_SIMPLE_3},
    oldGoal = OLD_SIMPLE,
    newGoal = NEW_SIMPLE,
    nonblocking,
	stepwise
}

||STEPWISE_UPDATE_CONTROLLER = UpdCont_stepwise.

updatingController UpdCont_1 = {
    oldController = OldCon_1,
    oldEnvironment = {SIMPLE_OLD_1},
	newEnvironment = {SIMPLE_NEW_1},
	mapRelation = {R_SIMPLE_1},
    oldGoal = OLD_SIMPLE_1,
    newGoal = NEW_SIMPLE_1,
    nonblocking
}

||UPDATE_CONTROLLER_1 = UpdCont_1.

updatingController UpdCont_2 = {
    oldController = OldCon_2,
    oldEnvironment = {SIMPLE_OLD_2},
	newEnvironment = {SIMPLE_NEW_2},
	mapRelation = {R_SIMPLE_2},
    oldGoal = OLD_SIMPLE_2,
    newGoal = NEW_SIMPLE_2,
    nonblocking
}

||UPDATE_CONTROLLER_2 = UpdCont_2.

updatingController UpdCont_3 = {
    oldController = OldCon_3,
    oldEnvironment = {SIMPLE_OLD_3},
	newEnvironment = {SIMPLE_NEW_3},
	mapRelation = {R_SIMPLE_3},
    oldGoal = OLD_SIMPLE_3,
    newGoal = NEW_SIMPLE_3,
    nonblocking
}

||UPDATE_CONTROLLER_3 = UpdCont_3.

||Stepwise_UPDATE_CONTROLLER = (UpdCont_1 || UpdCont_2 || UpdCont_3).
